---
/* /how-it-works — the system explained; the detailed sections that used to sit on the home page. */
import Base from "../layouts/Base.astro";
import LPHero from "../components/LP/LPHero.astro";
import LPSection from "../components/LP/LPSection.astro";
import FeatureGrid from "../components/LP/FeatureGrid.astro";
import TabMenu from "../components/TabsMenu/TabMenu.astro";
import ExplanationCardsContainer from "../components/ExplanationCardsContainer/ExplanationCardsContainer.astro";
import FoundationContainer from "../components/FoundationContainer/FoundationContainer.astro";
import CtaBand from "../components/LP/CtaBand.astro";
import { getLanguageFromURL, loadContent } from "../utils/i18n";

export const prerender = false;
const lang = getLanguageFromURL(Astro.url.pathname);
const c = await loadContent<any>("how-it-works", lang);
const index = await loadContent<any>("index", lang);
const md = (t: string) => t.replace(/\[([^\]]+)\]\(([^)]+)\)/g, '<a href="$2" target="_blank" rel="noopener noreferrer" class="text-[var(--color-blue-39)] underline">$1</a>');
---

<Base title={c.meta.title} description={c.meta.description}>
  <LPHero eyebrow={c.hero.eyebrow} title={c.hero.title} subtitle={c.hero.subtitle} />
  <LPSection><FeatureGrid items={index.how_simple.cards} /></LPSection>
  <LPSection title={index.how_it_works.title} subtitle={index.how_it_works.subtitle} accent>
    <div class="flex md:flex-row flex-col items-stretch gap-8"><TabMenu tabs={index.how_it_works.steps} /></div>
  </LPSection>
  <LPSection title={index.how_does_it_work.title}>
    <ExplanationCardsContainer cards={index.how_does_it_work.explanation} />
  </LPSection>
  <LPSection title={index.foundation.title} accent>
    <p class="ty-body-2 text-[var(--color-neutral-650)] max-w-3xl mb-8" set:html={md(index.foundation.description)} />
    <FoundationContainer />
  </LPSection>
  <CtaBand title="Ready to take part?" primary={{ label: "Start now", href: "https://app.frankencoin.com/savings" }} secondary={{ label: "Read the docs", href: "https://docs.frankencoin.com/" }} />
</Base>
