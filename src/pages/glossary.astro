---
/* /glossary — one-line definitions. Copy: content/en/glossary.json */
import Base from "../layouts/Base.astro";
import LPHero from "../components/LP/LPHero.astro";
import LPSection from "../components/LP/LPSection.astro";
import FeatureGrid from "../components/LP/FeatureGrid.astro";
import { getLanguageFromURL, getLocalizedPath, loadContent } from "../utils/i18n";

export const prerender = false;
const lang = getLanguageFromURL(Astro.url.pathname);
const en = await loadContent<any>("glossary", "en");
const local = await loadContent<any>("glossary", lang);
const c = { ...en, ...local };
const terms = [...c.terms].sort((a: any, b: any) => a.term.localeCompare(b.term));
// Definitions may carry one markdown link, e.g. CCIP → the cross-chain page.
const md = (t: string) => t.replace(/\[([^\]]+)\]\(([^)]+)\)/g, (_m, label, href) => `<a href="${href.startsWith("/") ? getLocalizedPath(href, lang) : href}" class="font-bold text-[var(--color-brand-swiss)] hover:underline">${label}</a>`);
---

<Base title={c.meta.title} description={c.meta.description}>
  <LPHero compact title={c.hero.title} subtitle={c.hero.subtitle} />
  <LPSection>
    <dl class="divide-y divide-[var(--color-gray-20)] m-0">
      {terms.map((t: any) => (
        <div id={t.term.toLowerCase().replace(/[^a-z0-9]+/g, "-")} class="py-4 grid sm:grid-cols-[200px_1fr] gap-1 sm:gap-6 scroll-mt-20">
          <dt class="ty-body-2 font-black text-[var(--color-brand-deep-blue)]">{t.term}</dt>
          <dd class="m-0 ty-body-3 text-[var(--color-neutral-650)]" set:html={md(t.def)} />
        </div>
      ))}
    </dl>
  </LPSection>
  <LPSection title={c.nextHead.title} accent>
    <FeatureGrid items={c.next} cols={2} />
  </LPSection>
</Base>
