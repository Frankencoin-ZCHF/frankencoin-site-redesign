---
/* /insurance — third-party depeg cover for ZCHF holders. Copy: content/en/insurance.json */
import Base from "../layouts/Base.astro";
import LPHero from "../components/LP/LPHero.astro";
import LPSection from "../components/LP/LPSection.astro";
import Steps from "../components/Steps/Steps.astro";
import CtaBand from "../components/LP/CtaBand.astro";
import { getLanguageFromURL, loadContent } from "../utils/i18n";

const lang = getLanguageFromURL(Astro.url.pathname);
const c = await loadContent<any>("insurance", lang);
---

<Base title={c.seo.title} description={c.seo.description}>
  <LPHero title={c.header.title} subtitle={c.header.subtitle} primary={c.products[0].cta} secondary={c.products[0].learnMore} />

  {c.products.map((p: any) => (
    <>
      <LPSection id="depeg-cover" title={p.title} subtitle={p.provider}>
        <p class="ty-body-1 text-pretty text-[var(--color-neutral-650)] max-w-3xl -mt-6 mb-8">{p.description}</p>
        <div class="grid grid-cols-2 md:grid-cols-3 gap-4">
          {p.highlights.map((h: any) => (
            <div class="rounded-3xl border border-[var(--color-gray-20)] bg-white p-5 md:p-6 min-w-0">
              <p class="ty-xs text-[var(--color-neutral-550)] m-0">{h.label}</p>
              <p class="mt-1.5 text-[22px] sm:text-[26px] font-black tracking-tight text-[var(--color-brand-deep-blue)] leading-tight m-0 break-words">{h.value}</p>
            </div>
          ))}
        </div>
        <div class="mt-4 grid md:grid-cols-2 gap-4">
          <div class="rounded-3xl bg-[var(--color-brand-deep-blue)] text-white p-6 md:p-7">
            <h3 class="ty-title-3 font-black m-0">{p.covered.title}</h3>
            <ul class="mt-4 m-0 p-0 list-none flex flex-col gap-3 ty-body-3 text-white/85">
              {p.covered.items.map((it: string) => <li class="flex gap-3"><span class="text-[#7ee2a8] font-bold">✓</span>{it}</li>)}
            </ul>
          </div>
          <div class="rounded-3xl border border-[var(--color-gray-20)] bg-[var(--color-gray-10)] p-6 md:p-7">
            <h3 class="ty-title-3 font-black text-[var(--color-brand-deep-blue)] m-0">{p.excluded.title}</h3>
            <ul class="mt-4 m-0 p-0 list-none flex flex-col gap-3 ty-body-3 text-[var(--color-neutral-650)]">
              {p.excluded.items.map((it: string) => <li class="flex gap-3"><span class="text-[var(--color-neutral-500)] font-bold">–</span>{it}</li>)}
            </ul>
          </div>
        </div>
      </LPSection>
      <LPSection title={p.howItWorks.title} accent>
        <Steps steps={p.howItWorks.steps.map((s: string, i: number) => ({ title: ["Open OpenCover", "Choose amount and term", "Pay and receive proof"][i] ?? `Step ${i + 1}`, body: s, cta: i === 0 ? { label: p.cta.label, href: p.cta.href, external: true } : i === 2 ? { label: p.learnMore.label, href: p.learnMore.href, external: true } : undefined }))} />
        <p class="mt-8 ty-xs text-[var(--color-neutral-550)] border-t border-[var(--color-gray-20)] pt-4 max-w-4xl"><b>{c.disclaimer.title}.</b> {c.disclaimer.text}</p>
      </LPSection>
    </>
  ))}

  <CtaBand {...c.cta} />
</Base>
