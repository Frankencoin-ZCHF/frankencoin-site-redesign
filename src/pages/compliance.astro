---
/* /compliance — Swiss and EU legal classification of ZCHF and FPS. Copy: content/en/compliance.json */
import Base from "../layouts/Base.astro";
import LPHero from "../components/LP/LPHero.astro";
import LPSection from "../components/LP/LPSection.astro";
import ProseRows from "../components/LP/ProseRows.astro";
import DocLinks from "../components/LP/DocLinks.astro";
import CtaBand from "../components/LP/CtaBand.astro";
import { getLanguageFromURL, loadContent } from "../utils/i18n";

const lang = getLanguageFromURL(Astro.url.pathname);
const en = await loadContent<any>("compliance", "en");
const local = await loadContent<any>("compliance", lang);
// German copy still has the legacy shape (swiss/eu/keyPoints); only keys present in both are overridden.
const c = { ...en, intro: local.intro ?? en.intro, rows: local.rows ?? en.rows, documents: local.documents ?? en.documents, cta: local.cta ?? en.cta, heroTitle: local.heroTitle ?? en.heroTitle };
const docs = c.documents.items;
---

<Base>
  <LPHero compact title={c.heroTitle} subtitle={c.intro} primary={docs[0]} secondary={docs[1]} />
  <LPSection><ProseRows rows={c.rows} /></LPSection>
  <LPSection id="documents" title={c.documents.title} accent split><DocLinks docs={docs} /></LPSection>
  <CtaBand {...c.cta} />
</Base>
