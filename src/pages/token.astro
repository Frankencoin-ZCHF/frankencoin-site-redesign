---
import Section from "../components/Layout/Section.astro";
import Base from "../layouts/Base.astro";
import LPHero from "../components/LP/LPHero.astro";
import LPSection from "../components/LP/LPSection.astro";
import CtaBand from "../components/LP/CtaBand.astro";
import Figures from "../components/LP/Figures.astro";
import { getLanguageFromURL, loadContent } from "../utils/i18n";
import ChainContainer from "../components/ChainContainer/ChainContainer.astro";

const currentLang = getLanguageFromURL(Astro.url.pathname);
const token = await loadContent("token", currentLang);
---

<Base>
  <LPHero eyebrow={token.hero.eyebrow ?? "Tokens & addresses"} title={token.hero.title} subtitle={token.hero.subtitle} />

  <Section
    id="tokens"
    title={token.tokens.title}
    subtitle={token.tokens.subtitle}
    pad="xxs"
    margin="mt-8"
  >
    <ChainContainer tokens={token.tokens.chains} />
  </Section>

  <Section
    id="fcs"
    title={token.fcs.title}
    subtitle={token.fcs.subtitle}
    pad="xxs"
    margin="mt-8"
  >
    <ChainContainer tokens={[token.fcs.chain]} />
  </Section>

  <Section
    id="svzchf"
    title={token.svzchf.title}
    subtitle={token.svzchf.subtitle}
    pad="xxs"
    margin="mt-8 mb-8"
  >
    <ChainContainer tokens={token.svzchf.chains} />
  </Section>
  <CtaBand title="Put your money in Swiss francs." body="Three steps, about ten minutes. You keep your own keys." primary={{ label: "Start now", href: "https://app.frankencoin.com/savings" }} secondary={{ label: "For developers", href: "/for/developers" }} />
</Base>
