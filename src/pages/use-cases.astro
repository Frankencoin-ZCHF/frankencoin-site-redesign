---
/* /use-cases — where ZCHF is accepted, grouped by task. Copy: content/en/use-cases.json */
import Base from "../layouts/Base.astro";
import LPHero from "../components/LP/LPHero.astro";
import LPSection from "../components/LP/LPSection.astro";
import { getLanguageFromURL, getLocalizedPath, loadContent } from "../utils/i18n";

const lang = getLanguageFromURL(Astro.url.pathname);
const en = await loadContent<any>("use-cases", "en");
const local = await loadContent<any>("use-cases", lang);
// German copy predates today's keys: fall back to English per key.
const c = { ...en, ...local };
const title = local.heroTitle ?? local.title ?? en.heroTitle;
const categories: string[] = c.categories ?? [...new Set(c.cases.map((x: any) => x.category))];
const localHref = (h: string) => (h.startsWith("/") ? getLocalizedPath(h, lang) : h);
---

<Base>
  <LPHero compact title={title} subtitle={c.intro} />

  <LPSection id="use-cases">
    <div x-data="{ cat: 'All' }">
      <div class="flex flex-wrap gap-2 mb-8" role="group" aria-label="Filter by category">
        {[c.filterAll ?? "All", ...categories].map((category, i) => (
          <button
            type="button"
            data-cat={i === 0 ? "All" : category}
            @click="cat = $el.dataset.cat"
            :class="cat === $el.dataset.cat ? 'bg-[var(--color-brand-deep-blue)] text-white border-[var(--color-brand-deep-blue)]' : 'bg-white text-[var(--color-brand-deep-blue)] border-[var(--color-gray-30)] hover:border-[var(--color-brand-deep-blue)]'"
            class="rounded-full border px-5 py-2 ty-body-3 font-bold transition-colors"
          >{category}</button>
        ))}
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
        {c.cases.map((u: any) => (
          <a
            href={u.link}
            target="_blank"
            rel="noopener noreferrer"
            data-cat={u.category}
            x-show="cat === 'All' || cat === $el.dataset.cat"
            class="group relative overflow-hidden flex flex-col rounded-2xl border border-[var(--color-gray-20)] bg-white p-6 md:p-6 hover:border-[var(--color-brand-deep-blue)]/40 transition-all"
          >
            <span class="halftone-dots absolute inset-0 text-[#5bb8dc]/40 opacity-0 group-hover:opacity-100 transition-opacity pointer-events-none"></span>
            <div class="relative h-14 flex items-center mb-4">
              <img src={u.image} alt={u.partner} class="max-h-12 max-w-[180px] object-contain" loading="lazy" />
            </div>
            <p class="relative ty-xs font-bold text-[var(--color-neutral-550)] m-0">{u.category}</p>
            <h3 class="relative text-balance ty-title-3 font-black text-[var(--color-brand-deep-blue)] m-0 mt-1">{u.title}</h3>
            <p class="relative mt-2 ty-body-3 text-[var(--color-neutral-650)] flex-1 m-0">{u.description}</p>
            <p class="relative mt-4 pt-4 border-t border-[var(--color-gray-20)] flex items-center justify-between ty-body-3 font-bold text-[var(--color-brand-deep-blue)] m-0">
              <span>{u.partner}</span><span class="text-[var(--color-brand-swiss)] transition-transform group-hover:translate-x-0.5">→</span>
            </p>
          </a>
        ))}
      </div>
    </div>

    {c.more && (
      <div class="mt-12 flex flex-wrap items-center gap-x-6 gap-y-3 border-t border-[var(--color-gray-20)] pt-8">
        <p class="ty-body-2 font-bold text-[var(--color-brand-deep-blue)] m-0">{c.more.title}</p>
        {c.more.links.map((l: any) => (
          <a href={localHref(l.href)} class="ty-body-2 font-bold text-[var(--color-brand-swiss)] hover:underline">{l.label} →</a>
        ))}
      </div>
    )}
  </LPSection>
</Base>
