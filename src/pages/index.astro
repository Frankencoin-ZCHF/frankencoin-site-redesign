---
/*
 * Home. Copy: src/content/en/home.json (+ index.json for doors, faq.json, shared/media.json).
 * Live figures: calcStats (rate, ROE), liveStats (borrow terms, transparency). All cached 5 minutes.
 */
import Base from "../layouts/Base.astro";
import HomeHero from "../components/Home/HomeHero.astro";
import SectionHead from "../components/Home/SectionHead.astro";
import DollarTruth from "../components/Home/DollarTruth.astro";
import CoinStack from "../components/Home/CoinStack.astro";
import AudienceDoors from "../components/AudienceDoors/AudienceDoors.astro";
import MediaCarousel from "../components/MediaCarousel/MediaCarousel.astro";
import FaqList from "../components/LP/FaqList.astro";
import StickyCTA from "../components/StickyCTA/StickyCTA.astro";
import GlassButton from "../components/LP/GlassButton.astro";
import { getLanguageFromURL, loadContent, loadGlobalSharedContent, getLocalizedPath } from "../utils/i18n";
import { getCalcData } from "../utils/calcStats";
import { getBorrowOptions, getTransparency } from "../utils/liveStats";
import { formatAmount, formatPct, getFcsStats, ROE_YEARS } from "../utils/fcsStats";

export const prerender = false;

const lang = getLanguageFromURL(Astro.url.pathname);
const c = await loadContent<any>("home", lang);
const index = await loadContent<any>("index", lang);
const faq = await loadContent<any>("faq", lang);
const media = await loadGlobalSharedContent<any>("media");
const eco = await loadContent<any>("ecosystem", lang);
const [calc, borrow, t, fcs] = await Promise.all([getCalcData(), getBorrowOptions(), getTransparency(), getFcsStats()]);
// Invest card: protocol ROE per window (same maths as the dapp's equity page), "All" shown first.
const R = c.products.invest.roe;
const thisYear = String(new Date().getUTCFullYear());
const roePeriods = ["all", ...ROE_YEARS] as const;
const roeCard = {
  label: Object.fromEntries(roePeriods.map((k) => [k, k === "all" ? R.all : k])),
  value: Object.fromEntries(roePeriods.map((k) => [k, fcs.roe[k] === null ? "—" : formatPct(fcs.roe[k], 1)])),
  caption: Object.fromEntries(roePeriods.map((k) => [k, k === "all" ? R.since : (k === thisYear ? R.ytd : R.year).replace("{year}", k)])),
};

const href = (h: string) => (h.startsWith("/") ? getLocalizedPath(h, lang) : h);
const rate = formatPct(calc.current.rate, 2).replace(/\.00%$/, "%");
const ratio = t.supply && t.collateralChf ? (t.collateralChf / t.supply).toFixed(2) : "—";
const compact = (n: number | null) =>
  n === null ? "—" : n >= 1e6 ? `${(n / 1e6).toFixed(1)}M` : formatAmount(n);
const maxLtv = borrow.length ? Math.max(...borrow.map((b) => b.ltv)) : null;
const minRate = borrow.length ? Math.min(...borrow.map((b) => b.interest)) : null;
// Nine partner wordmarks for the strip (one even desktop row), in this order; own products and icon-only marks are left out.
const LOGO_PICK = ["Mt Pelerin", "DFX", "Spar", "Zeal", "PrivCart", "Ammer", "Morpho", "Uniswap", "Bitcoin Suisse"];
// Optical sizing: wordmarks of very different proportions get their own height so they read as one row.
const LOGO_SIZE: Record<string, string> = { "Mt Pelerin": "h-9", DFX: "h-7", Spar: "h-6", Zeal: "h-11", PrivCart: "h-6", Ammer: "h-[14px]", Morpho: "h-11", Uniswap: "h-6", "Bitcoin Suisse": "h-9" };
const logos = LOGO_PICK.map((n) => { const t = (eco.tabs ?? []).find((x: any) => x.image && x.name.startsWith(n)); return t && { ...t, size: LOGO_SIZE[n] }; }).filter(Boolean);

const doors = index.doors.items.map(({ stat, ...d }: any) => d);
const faqItems = faq.categories.flatMap((cat: any) => cat.questions).slice(0, 5).map((q: any) => ({ q: q.question, a: q.answer }));
const P = c.products;

Astro.response.headers.set("Cache-Control", "public, max-age=300, s-maxage=300");
---

<Base>
  <HomeHero
    announcement={c.hero.announcement}
    title={c.hero.title}
    subtitle={c.hero.subtitle}
    primary={{ ...c.hero.primary, label: c.hero.primary.label.replace("{rate}", rate) }}
    secondary={c.hero.secondary}
    routes={c.hero.routes}
    ticker={[
      { label: c.hero.ticker.rate, value: rate, href: c.hero.tickerLinks.rate },
      { label: c.hero.ticker.supply, value: compact(t.supply), href: c.hero.tickerLinks.supply },
      { label: c.hero.ticker.collateral, value: `${ratio}×`, href: c.hero.tickerLinks.collateral },
      { label: c.hero.ticker.since, value: "2023" },
    ]}
  />

  <!-- Trust + logos -->
  <!-- Partner logos: a slow marquee below lg (two copies for a seamless loop; still on reduced motion), one even row of nine on desktop. -->
  <section class="border-t border-[var(--color-gray-20)] bg-[var(--color-white)] py-8 md:py-10 overflow-hidden">
    <div class="lg:hidden relative [mask-image:linear-gradient(to_right,transparent,black_12%,black_88%,transparent)]">
      <div class="logo-marquee flex w-max items-center gap-10 pr-10">
        {[0, 1].map((copy) => logos.map((l: any) => (
          <a href={l.href} target="_blank" rel="noopener noreferrer" title={l.name} aria-hidden={copy === 1 ? "true" : undefined} tabindex={copy === 1 ? -1 : undefined} class="flex h-9 items-center shrink-0 opacity-60 grayscale">
            <img src={l.image} alt={copy === 1 ? "" : (l.imageAlt ?? l.name)} loading="lazy" class:list={["w-auto max-w-[120px] object-contain", l.size]} />
          </a>
        )))}
      </div>
    </div>
    <div class="hidden lg:grid mx-auto max-w-7xl px-[var(--spacing-l)] grid-cols-9 gap-x-4 items-center">
      {logos.map((l: any) => (
        <a href={l.href} target="_blank" rel="noopener noreferrer" title={l.name} class="flex h-9 items-center justify-center opacity-55 grayscale hover:opacity-100 hover:grayscale-0 transition">
          <img src={l.image} alt={l.imageAlt ?? l.name} loading="lazy" class:list={["w-auto max-w-[120px] object-contain", l.size]} />
        </a>
      ))}
    </div>
  </section>

  <!-- 01 Products bento -->
  <section class="bg-[var(--color-gray-10)] py-20 md:py-28">
    <div class="mx-auto max-w-7xl px-[var(--spacing-l)]">
      <SectionHead eyebrow={P.eyebrow} title={P.title} />
      <div class="grid gap-4 lg:grid-cols-6">
        <!-- Save -->
        <a href={href(P.save.href)} class="group relative overflow-hidden lg:col-span-4 rounded-3xl bg-white border border-[var(--color-gray-20)] p-7 md:p-10 flex flex-col min-h-[300px] hover:shadow-xl hover:-translate-y-0.5 transition-all">
          <span class="halftone-dots absolute inset-0 text-[#5bb8dc]/50 pointer-events-none"></span>
          <span class="relative font-mono text-[11px] uppercase tracking-[0.24em] text-[#1a9cc8]">{P.save.label}</span>
          <span class="relative mt-4 text-[64px] md:text-[96px] font-black leading-none tracking-[-0.04em] text-[var(--color-brand-deep-blue)]">{rate}<span class="text-[18px] md:text-[22px] font-bold tracking-normal text-[var(--color-neutral-550)] ml-2">{P.save.stat}</span></span>
          <span class="relative mt-4 ty-title-2 font-black text-[var(--color-brand-deep-blue)]">{P.save.title.replace("{rate}", rate)}</span>
          <span class="relative mt-2 ty-body-2 text-[var(--color-neutral-650)] max-w-md">{P.save.body}</span>
          <span class="relative mt-auto pt-6 font-bold ty-body-2 text-[var(--color-brand-swiss)]">{P.save.cta} →</span>
        </a>
        <!-- Invest (dark): the whole card links to /fcs (stretched link); the period switch sits above it. -->
        <div x-data={JSON.stringify({ p: "all", roe: roeCard })} class="group relative overflow-hidden lg:col-span-2 rounded-3xl bg-[var(--color-brand-deep-blue)] text-white p-7 md:p-8 flex flex-col min-h-[300px] hover:shadow-xl hover:-translate-y-0.5 transition-all">
          <span class="halftone-dots absolute inset-0 text-[#1a9cc8]/60 pointer-events-none"></span>
          <span class="relative font-mono text-[11px] uppercase tracking-[0.24em] text-[#5bb8dc]">{P.invest.label}</span>
          <span class="relative mt-4 text-[56px] font-black leading-none tracking-[-0.04em] tabular-nums" x-text="roe.value[p]">{roeCard.value.all}</span>
          <span class="relative mt-2 ty-xs opacity-80">{R.stat}. <span x-text="roe.caption[p]">{roeCard.caption.all}</span></span>
          <div class="relative z-10 mt-4 inline-flex w-max gap-0.5 rounded-full bg-white/10 p-1" role="group" aria-label={R.stat}>
            {roePeriods.map((k) => (
              <button type="button" @click={`p = '${k}'`} :class={`p === '${k}' ? 'bg-white text-[var(--color-brand-deep-blue)]' : 'text-white/75 hover:text-white'`} class="rounded-full px-3 py-1 text-[12px] font-bold transition-colors">{roeCard.label[k]}</button>
            ))}
          </div>
          <a href={href(P.invest.href)} class="relative mt-5 ty-title-3 font-black text-balance">{P.invest.title}</a>
          <span class="relative mt-2 ty-body-3 opacity-85">{P.invest.body}</span>
          <span class="relative mt-auto pt-6 font-bold ty-body-2 text-[#5bb8dc]">{P.invest.cta} →</span>
          <a href={href(P.invest.href)} aria-hidden="true" tabindex="-1" class="absolute inset-0 z-[1]"><span class="sr-only">{P.invest.cta}</span></a>
        </div>
        <!-- Borrow -->
        <a href={href(P.borrow.href)} class="group relative overflow-hidden lg:col-span-3 rounded-3xl bg-white border border-[var(--color-gray-20)] p-7 md:p-8 flex flex-col min-h-[260px] hover:shadow-xl hover:-translate-y-0.5 transition-all">
          <span class="relative font-mono text-[11px] uppercase tracking-[0.24em] text-[#1a9cc8]">{P.borrow.label}</span>
          <span class="relative mt-4 ty-title-2 font-black text-[var(--color-brand-deep-blue)]">{P.borrow.title}</span>
          <span class="relative mt-2 ty-body-3 text-[var(--color-neutral-650)]">{P.borrow.body}</span>
          <span class="relative mt-5 flex flex-wrap gap-2">
            {maxLtv !== null && <span class="rounded-full bg-[var(--color-gray-10)] border border-[var(--color-gray-20)] px-3 py-1.5 font-mono text-[11px] uppercase tracking-[0.12em] text-[var(--color-brand-deep-blue)]">{P.borrow.ltv.replace("{ltv}", formatPct(maxLtv, 0))}</span>}
            {minRate !== null && <span class="rounded-full bg-[var(--color-gray-10)] border border-[var(--color-gray-20)] px-3 py-1.5 font-mono text-[11px] uppercase tracking-[0.12em] text-[var(--color-brand-deep-blue)]">{P.borrow.rate.replace("{rate}", formatPct(minRate, 2))}</span>}
          </span>
          <span class="relative mt-auto pt-6 font-bold ty-body-2 text-[var(--color-brand-swiss)]">{P.borrow.cta} →</span>
        </a>
        <!-- Pay -->
        <a href={href(P.pay.href)} class="group relative overflow-hidden lg:col-span-3 rounded-3xl bg-white border border-[var(--color-gray-20)] p-7 md:p-8 flex flex-col min-h-[260px] hover:shadow-xl hover:-translate-y-0.5 transition-all">
          <span class="halftone-dots absolute inset-0 text-[#5bb8dc]/40 pointer-events-none"></span>
          <span class="relative font-mono text-[11px] uppercase tracking-[0.24em] text-[#1a9cc8]">{P.pay.label}</span>
          <span class="relative mt-4 ty-title-2 font-black text-[var(--color-brand-deep-blue)]">{P.pay.title}</span>
          <span class="relative mt-2 ty-body-3 text-[var(--color-neutral-650)] max-w-sm">{P.pay.body}</span>
          <span class="relative mt-auto pt-6 font-bold ty-body-2 text-[var(--color-brand-swiss)]">{P.pay.cta} →</span>
        </a>
      </div>
    </div>
  </section>

  <!-- 02 Dollar truth, compact: the full comparison lives on the Save page -->
  <DollarTruth compact objections={false} more={c.dollar} />

  <!-- 02 Backing: live proof and the mechanism in one block -->
  <section class="bg-[var(--color-white)] py-20 md:py-28">
    <div class="mx-auto max-w-7xl px-[var(--spacing-l)]">
      <div class="grid lg:grid-cols-[1.3fr_1fr] gap-8 lg:gap-12 items-end mb-10 md:mb-14">
        <div class="[&>div]:mb-0"><SectionHead title={c.proof.title} subtitle={c.proof.subtitle} /></div>
        <div class="lg:justify-self-end"><CoinStack label={c.proof.coins} /></div>
      </div>
      <div class="grid grid-cols-2 lg:grid-cols-4 gap-px overflow-hidden rounded-3xl border border-[var(--color-gray-20)] bg-[var(--color-gray-20)]">
        {[
          { l: c.proof.supply, v: compact(t.supply) },
          { l: c.proof.collateral, v: compact(t.collateralChf) },
          { l: c.proof.ratio, v: `${ratio}×` },
          { l: c.proof.equity, v: compact(t.equity) },
        ].map((x) => (
          <div class="bg-white p-5 md:p-7">
            <p class="ty-xs text-[var(--color-neutral-550)]">{x.l}</p>
            <p class="mt-2 text-[24px] md:text-[34px] font-black tracking-tight text-[var(--color-brand-deep-blue)] tabular-nums break-words">{x.v}</p>
          </div>
        ))}
      </div>
      <div class="mt-6 flex flex-wrap gap-x-8 gap-y-2">
        <a href={href(c.proof.href)} class="inline-flex font-bold ty-body-2 text-[var(--color-brand-swiss)] hover:text-[var(--color-blue-39)]">{c.proof.cta} →</a>
        <a href={href(c.proof.howHref)} class="inline-flex font-bold ty-body-2 text-[var(--color-brand-swiss)] hover:text-[var(--color-blue-39)]">{c.proof.how} →</a>
      </div>
    </div>
  </section>

  <!-- 04 Doors -->
  <section class="bg-[var(--color-white)] py-20 md:py-28">
    <div class="mx-auto max-w-7xl px-[var(--spacing-l)]">
      <SectionHead eyebrow={c.doors.eyebrow} title={c.doors.title} />
      <AudienceDoors doors={doors} />
    </div>
  </section>

  <!-- 05 Media -->
  <section class="bg-[var(--color-gray-10)] py-20 md:py-24">
    <div class="mx-auto max-w-7xl px-[var(--spacing-l)]">
      <SectionHead eyebrow={c.media.eyebrow} title={c.media.title} />
      <MediaCarousel articles={media.articles} videos={media.videos} />
    </div>
  </section>

  <!-- 06 FAQ -->
  <section class="bg-[var(--color-white)] py-20 md:py-24">
    <div class="mx-auto max-w-3xl px-[var(--spacing-l)]">
      <SectionHead eyebrow={c.faq.eyebrow} title={c.faq.title} />
      <FaqList items={faqItems} />
      <a href={href(c.faq.href)} class="inline-flex mt-6 font-bold ty-body-2 text-[var(--color-brand-swiss)] hover:text-[var(--color-blue-39)]">{c.faq.more} →</a>
    </div>
  </section>

  <!-- Final CTA over the dark part of the image -->
  <section class="relative isolate overflow-hidden bg-[#0b4a64] text-white">
    <img src="/images/home/alps-halftone.webp" alt="" loading="lazy" width="2000" height="1121" class="absolute inset-0 -z-10 h-full w-full object-cover object-[50%_85%] opacity-90" />
    <div class="absolute inset-0 -z-10 bg-gradient-to-r from-[#062a3d]/95 via-[#0b4a64]/75 to-[#0b4a64]/20"></div>
    <div class="mx-auto max-w-7xl px-[var(--spacing-l)] py-24 md:py-32">
      <h2 class="text-[38px] sm:text-[56px] leading-[1] font-black tracking-[-0.035em] max-w-2xl m-0">{c.final.title}</h2>
      <p class="mt-4 ty-body-1 text-white/85 max-w-lg">{c.final.subtitle}</p>
      <div class="mt-8 flex flex-wrap gap-3">
        <GlassButton href={c.final.primary.href} label={c.final.primary.label} variant="dark" arrow />
        <GlassButton href={c.final.secondary.href} label={c.final.secondary.label} variant="dark" />
      </div>
    </div>
  </section>

  <StickyCTA label={index.sticky.label} sub={index.sticky.sub} href={index.sticky.href} />
</Base>
