---
/* /contact — contact form for the Association (posts to /api/contact) plus the other ways in. Copy: content/{en,de}/contact.json */
import Base from "../layouts/Base.astro";
import LPHero from "../components/LP/LPHero.astro";
import LPSection from "../components/LP/LPSection.astro";
import { getLanguageFromURL, getLocalizedPath, loadContent } from "../utils/i18n";

export const prerender = false;
const lang = getLanguageFromURL(Astro.url.pathname);
const en = await loadContent<any>("contact", "en");
const local = await loadContent<any>("contact", lang);
const c = { ...en, ...local };
const f = c.form;
const topicParam = Astro.url.searchParams.get("topic") ?? "";
const topic = f.topics.some((t: any) => t.value === topicParam) ? topicParam : "";
const href = (h: string) => (h.startsWith("/") ? getLocalizedPath(h, lang) : h);
const right = [3, 0, 0, 0, 4, 0, 0, 2, 1, 3, 0, 0];
const field = "mt-1.5 block w-full rounded-xl border border-[var(--color-gray-30)] bg-white px-4 py-3 ty-body-2 text-[var(--color-neutral-800)] placeholder:text-[var(--color-neutral-450)] focus:border-[var(--color-brand-swiss)] focus:outline-none focus:ring-2 focus:ring-[var(--color-brand-swiss)]/30";
const label = "block ty-xs font-bold uppercase tracking-[0.06em] text-[var(--color-neutral-650)]";
---

<Base title={c.meta.title} description={c.meta.description}>
  <LPHero compact title={c.hero.title} subtitle={c.hero.subtitle} />

  <LPSection id="form" title={f.title} subtitle={f.subtitle} split>
    <form
      x-data={`contactForm(${JSON.stringify({ lang, page: Astro.url.pathname })})`}
      x-on:submit.prevent="submit($el)"
      novalidate
      class="rounded-3xl border border-[var(--color-gray-20)] bg-[var(--color-gray-10)] p-6 md:p-8"
    >
      <div class="grid gap-5 sm:grid-cols-2">
        <label class="block">
          <span class={label}>{f.name}</span>
          <input name="name" type="text" required autocomplete="name" class={field} />
        </label>
        <label class="block">
          <span class={label}>{f.email}</span>
          <input name="email" type="email" required autocomplete="email" inputmode="email" class={field} />
        </label>
        <label class="block">
          <span class={label}>{f.company} <span class="font-normal normal-case tracking-normal text-[var(--color-neutral-450)]">({f.companyOptional})</span></span>
          <input name="company" type="text" autocomplete="organization" class={field} />
        </label>
        <label class="block">
          <span class={label}>{f.topic}</span>
          <select name="topic" class={field}>
            <option value="" selected={!topic}></option>
            {f.topics.map((t: any) => <option value={t.value} selected={t.value === topic}>{t.label}</option>)}
          </select>
        </label>
        <label class="block sm:col-span-2">
          <span class={label}>{f.message}</span>
          <textarea name="message" rows="6" required placeholder={f.messagePlaceholder} class={`${field} resize-y`}></textarea>
        </label>
      </div>

      <!-- Honeypot: hidden from people, filled by bots. -->
      <div class="absolute -left-[9999px] top-auto h-px w-px overflow-hidden" aria-hidden="true">
        <label>Website <input name="website" type="text" tabindex="-1" autocomplete="off" /></label>
      </div>
      <input type="hidden" name="started" x-bind:value="started" />

      <p class="mt-5 ty-xs text-[var(--color-neutral-550)] m-0">{f.consent}</p>

      <div class="mt-6 flex flex-wrap items-center gap-4">
        <button type="submit" x-bind:disabled="state === 'sending' || state === 'done'" class="pxb pxb--solid disabled:opacity-60">
          <span class="pxb_bg" aria-hidden="true">
            <span class="pxb_mid"></span>
            <span class="pxb_side pxb_side--r">{right.map((i) => <span class="pxb_px" style={`--i:${i}`}></span>)}</span>
          </span>
          <span class="pxb_inner"><span class="pxb_text" x-text={`state === 'sending' ? ${JSON.stringify(f.sending)} : ${JSON.stringify(f.submit)}`}>{f.submit}</span></span>
        </button>
        <a href="mailto:info@frankencoin.com" class="ty-body-3 font-semibold text-[var(--color-brand-deep-blue)] hover:text-[var(--color-brand-swiss)]">{f.emailLabel}</a>
      </div>

      <p x-cloak x-show="state === 'done'" role="status" class="mt-5 rounded-xl border border-[color-mix(in_oklab,var(--color-brand-swiss)_40%,white)] bg-[color-mix(in_oklab,var(--color-brand-swiss)_12%,white)] px-4 py-3 ty-body-2 font-semibold text-[var(--color-brand-deep-blue)] m-0">{f.success}</p>
      <p x-cloak x-show="state === 'invalid'" role="alert" class="mt-5 rounded-xl border border-red-200 bg-red-50 px-4 py-3 ty-body-2 text-red-800 m-0">{f.errorValidation}</p>
      <p x-cloak x-show="state === 'error'" role="alert" class="mt-5 rounded-xl border border-red-200 bg-red-50 px-4 py-3 ty-body-2 text-red-800 m-0">
        {f.errorServer} <a href="mailto:info@frankencoin.com" class="font-bold underline">{f.emailLabel}</a>
      </p>
    </form>
  </LPSection>

  <LPSection id="other" title={c.aside.title} accent>
    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {c.aside.items.map((it: any) => (
        <a href={href(it.href)} {...(it.href.startsWith("http") ? { target: "_blank", rel: "noopener noreferrer" } : {})} class="group flex flex-col rounded-3xl border border-[var(--color-gray-20)] bg-white p-6 transition-colors hover:border-[var(--color-brand-swiss)]">
          <h3 class="ty-title-3 font-black text-[var(--color-brand-deep-blue)] m-0">{it.title}</h3>
          <p class="mt-2 flex-1 ty-body-3 text-pretty text-[var(--color-neutral-650)] m-0">{it.text}</p>
          <span class="mt-4 ty-body-3 font-semibold text-[var(--color-brand-deep-blue)] group-hover:text-[var(--color-brand-swiss)]">{it.label} {it.href.startsWith("http") ? "↗" : "→"}</span>
        </a>
      ))}
    </div>
  </LPSection>
</Base>

<script is:inline>
  function contactForm(ctx) {
    return {
      state: "idle",
      started: Date.now(),
      async submit(form) {
        const fd = new FormData(form);
        const email = String(fd.get("email") || "");
        if (!String(fd.get("name") || "").trim() || !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email) || String(fd.get("message") || "").trim().length < 10) {
          this.state = "invalid";
          return;
        }
        this.state = "sending";
        fd.set("lang", ctx.lang);
        fd.set("page", ctx.page);
        try {
          const res = await fetch("/api/contact", { method: "POST", body: fd, headers: { Accept: "application/json" } });
          const body = await res.json().catch(() => ({}));
          if (res.ok && body.ok) {
            this.state = "done";
            if (window.fcTrack) window.fcTrack("contact_submit", { topic: String(fd.get("topic") || "none"), page_path: ctx.page });
          } else {
            this.state = res.status === 422 ? "invalid" : "error";
          }
        } catch (e) {
          this.state = "error";
        }
      },
    };
  }
</script>
