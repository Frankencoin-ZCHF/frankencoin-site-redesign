---
/* /for/savers — retail and crypto-native savers. Copy: content/en/savers.json */
import Base from "../../layouts/Base.astro";
import LPHero from "../../components/LP/LPHero.astro";
import LPSection from "../../components/LP/LPSection.astro";
import Figures from "../../components/LP/Figures.astro";
import FeatureGrid from "../../components/LP/FeatureGrid.astro";
import Calculator from "../../components/Calculator/Calculator.astro";
import TrustStrip from "../../components/TrustStrip/TrustStrip.astro";
import StickyCTA from "../../components/StickyCTA/StickyCTA.astro";
import { getLanguageFromURL, loadContent } from "../../utils/i18n";
import { getCalcData } from "../../utils/calcStats";
import { formatAmount, formatPct } from "../../utils/fcsStats";

export const prerender = false;
const lang = getLanguageFromURL(Astro.url.pathname);
const c = await loadContent<any>("savers", lang);
const d = await getCalcData();
const figures = [
  { ...c.figures.rate, value: formatPct(d.current.rate, 2) },
  { ...c.figures.saved, value: formatAmount(d.current.totalSavings) },
  { ...c.figures.roe, value: formatPct(d.current.roe12m, 1) },
  { ...c.figures.price, value: formatAmount(d.current.fpsPrice) },
];
Astro.response.headers.set("Cache-Control", "public, max-age=300, s-maxage=300");
---

<Base title={c.meta.title} description={c.meta.description}>
  <LPHero eyebrow={c.hero.eyebrow} title={c.hero.title} subtitle={c.hero.subtitle} primary={c.hero.primary} secondary={c.hero.secondary}>
    <Figures slot="aside" items={figures} />
  </LPHero>
  <LPSection title={c.paths.title}><FeatureGrid items={c.paths.items} cols={2} /></LPSection>
  <LPSection accent><Calculator /></LPSection>
  <LPSection id="compare" title={c.compare.title} subtitle={c.compare.subtitle}>
    <div class="overflow-x-auto">
      <table class="w-full border-separate border-spacing-0 rounded-2xl overflow-hidden border border-[var(--color-gray-20)] ty-body-3">
        <thead><tr class="bg-[var(--color-gray-15)]"><th class="p-4"></th><th class="text-left p-4 ty-body-2 font-black text-[var(--color-brand-deep-blue)]">{c.compare.head.save}</th><th class="text-left p-4 ty-body-2 font-black text-[var(--color-brand-deep-blue)]">{c.compare.head.invest}</th></tr></thead>
        <tbody>{c.compare.rows.map((r: any) => (<tr><th scope="row" class="text-left p-4 font-bold text-[var(--color-neutral-600)] border-t border-[var(--color-gray-20)]">{r.label}</th><td class="p-4 border-t border-[var(--color-gray-20)]">{r.save}</td><td class="p-4 border-t border-[var(--color-gray-20)]">{r.invest}</td></tr>))}</tbody>
      </table>
    </div>
  </LPSection>
  <LPSection accent><TrustStrip items={c.trust} /></LPSection>
  <StickyCTA label={c.sticky.label} sub={c.sticky.sub} href="/start" />
</Base>
