---
/* /for/exchanges-wallets — listings, savings integration, referral. Copy: content/en/exchanges-wallets.json */
import Base from "../../layouts/Base.astro";
import LPHero from "../../components/LP/LPHero.astro";
import LPSection from "../../components/LP/LPSection.astro";
import Figures from "../../components/LP/Figures.astro";
import FeatureGrid from "../../components/LP/FeatureGrid.astro";
import Steps from "../../components/Steps/Steps.astro";
import CtaBand from "../../components/LP/CtaBand.astro";
import { getLanguageFromURL, loadContent } from "../../utils/i18n";
import { getTransparency } from "../../utils/liveStats";
import { getCalcData } from "../../utils/calcStats";
import { formatAmount, formatPct } from "../../utils/fcsStats";

export const prerender = false;
const lang = getLanguageFromURL(Astro.url.pathname);
const c = await loadContent<any>("exchanges-wallets", lang);
const [t, d] = await Promise.all([getTransparency(), getCalcData()]);
Astro.response.headers.set("Cache-Control", "public, max-age=300, s-maxage=300");
---

<Base title={c.meta.title} description={c.meta.description}>
  <LPHero eyebrow={c.hero.eyebrow} title={c.hero.title} subtitle={c.hero.subtitle} primary={c.hero.primary} secondary={c.hero.secondary}>
    <Figures slot="aside" items={[
      { label: "ZCHF supply", value: formatAmount(t.supply), unit: "all chains" },
      { label: "Chains", value: String(t.supplyByChain.length || 8), unit: "via Chainlink CCIP" },
      { label: "Savings rate", value: formatPct(d.current.rate, 2), unit: "per year" },
      { label: "Referral share", value: "≤25%", unit: "of savers' interest" },
    ]} />
  </LPHero>
  <LPSection eyebrow={c.why.eyebrow} title={c.why.title}><FeatureGrid items={c.why.items} cols={4} /></LPSection>
  <LPSection eyebrow={c.steps.eyebrow} title={c.steps.title} accent><Steps steps={c.steps.items} /></LPSection>
  <LPSection eyebrow={c.data.eyebrow} title={c.data.title}><FeatureGrid items={c.data.items} /></LPSection>
  <CtaBand {...c.cta} />
</Base>
