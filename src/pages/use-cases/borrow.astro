---
/* /use-cases/borrow — borrow ZCHF against crypto, gold or shares. Live terms from utils/liveStats.ts. Copy: content/en/borrow.json */
import Base from "../../layouts/Base.astro";
import LPHero from "../../components/LP/LPHero.astro";
import LPSection from "../../components/LP/LPSection.astro";
import FaqList from "../../components/LP/FaqList.astro";
import StickyCTA from "../../components/StickyCTA/StickyCTA.astro";
import CtaBand from "../../components/LP/CtaBand.astro";
import { getLanguageFromURL, loadContent } from "../../utils/i18n";
import { getBorrowOptions } from "../../utils/liveStats";
import { formatPct } from "../../utils/fcsStats";
import fs from "node:fs";

export const prerender = false;
const lang = getLanguageFromURL(Astro.url.pathname);
const en = await loadContent<any>("borrow", "en");
const local = await loadContent<any>("borrow", lang);
// German copy may lack today's keys: fall back to English per key.
const c = { ...en, ...local };
const all = await getBorrowOptions();
const options = all.slice(0, 8);
// Coin logos live in public/images/coins (copied from the dapp); missing ones fall back to initials.
const coinFiles = new Set(fs.readdirSync(new URL("../../../public/images/coins/", import.meta.url)));
const coin = (symbol: string) => ["svg", "png"].map((e) => `${symbol.toLowerCase()}.${e}`).find((f) => coinFiles.has(f));
// Logos shown next to the three asset classes in the hero, in the order of collateral.items.
const HERO_COINS = [["wbtc", "cbbtc", "weth", "wsteth"], ["xaut", "paxg"], ["realu", "boss", "spyon"]];
const date = (s: number) => new Date(s * 1000).toLocaleDateString(lang === "de" ? "de-CH" : "en-GB", { month: "short", year: "numeric" });
const th = "p-4 ty-xs font-bold text-[var(--color-neutral-600)]";
const def = "underline decoration-dotted decoration-[var(--color-gray-30)] underline-offset-4 cursor-help";
Astro.response.headers.set("Cache-Control", "public, max-age=300, s-maxage=300");
---

<Base title={c.meta.title} description={c.meta.description}>
  <LPHero title={c.hero.title} subtitle={c.hero.subtitle} primary={c.hero.primary} secondary={c.hero.secondary} image="/images/home/peak-teal-halftone.webp" imageLayout="side" imagePosition="object-[62%_12%]">
    <!-- One white panel, three rows: what the asset class is, and the logos of collaterals in it. -->
    <ul slot="aside" class="m-0 p-0 list-none overflow-hidden rounded-2xl border border-[var(--color-gray-20)] bg-white divide-y divide-[var(--color-gray-20)] shadow-[0_8px_24px_-16px_rgba(9,47,98,0.25)]">
      {c.collateral.items.map((it: any, i: number) => (
        <li class="flex items-center gap-4 p-4 md:p-6">
          <div class="min-w-0 flex-1">
            <h3 class="ty-body-1 font-black text-[var(--color-brand-deep-blue)] m-0">{it.title}</h3>
            <p class="mt-1 ty-body-3 text-[var(--color-neutral-650)] m-0">{it.description}</p>
          </div>
          <div class="flex shrink-0 items-center" aria-hidden="true">
            {(HERO_COINS[i] ?? []).map((sym, k) => coin(sym) && (
              <img src={`/images/coins/${coin(sym)}`} alt="" loading="lazy" class:list={["h-8 w-8 md:h-10 md:w-10 rounded-full bg-white ring-2 ring-white object-cover", k > 0 && "-ml-2"]} />
            ))}
          </div>
        </li>
      ))}
    </ul>
  </LPHero>

  <LPSection id="rates" title={c.rates.title} subtitle={c.rates.subtitle}>
    {options.length === 0 ? (
      <p class="ty-body-2 text-[var(--color-neutral-550)]">{c.rates.empty} <a class="font-bold text-[var(--color-blue-39)]" href="https://app.frankencoin.com/mint" target="_blank" rel="noopener noreferrer">app.frankencoin.com</a></p>
    ) : (
      <>
        <div class="hidden md:block overflow-hidden rounded-2xl border border-[var(--color-gray-20)] bg-white">
          <table class="w-full ty-body-3">
            <thead class="bg-[var(--color-gray-10)] text-left">
              <tr>
                <th class={th}>{c.rates.cols.asset}</th>
                <th class={`${th} text-right`}><abbr title={c.rates.defs.ltv} class={def}>{c.rates.cols.ltv}</abbr></th>
                <th class={`${th} text-right`}><abbr title={c.rates.defs.rate} class={def}>{c.rates.cols.rate}</abbr></th>
                <th class={`${th} text-right`}><abbr title={c.rates.defs.maturity} class={def}>{c.rates.cols.maturity}</abbr></th>
                <th class={th}></th>
              </tr>
            </thead>
            <tbody>
              {options.map((o) => (
                <tr class="border-t border-[var(--color-gray-20)]">
                  <td class="p-4"><span class="inline-flex items-center gap-3">
                    <span class="h-8 w-8 shrink-0 rounded-full bg-[var(--color-gray-10)] ring-1 ring-[var(--color-gray-20)] overflow-hidden grid place-items-center">{coin(o.symbol) ? <img src={`/images/coins/${coin(o.symbol)}`} alt="" loading="lazy" class="h-full w-full object-cover" /> : <span class="text-[10px] font-bold text-[var(--color-brand-deep-blue)]">{o.symbol.slice(0, 3)}</span>}</span>
                    <span><span class="font-bold text-[var(--color-brand-deep-blue)]">{o.symbol}</span> <span class="text-[var(--color-neutral-550)]">{o.name}</span></span>
                  </span></td>
                  <td class="p-4 text-right font-black text-[var(--color-brand-deep-blue)] tabular-nums">{formatPct(o.ltv, 0)}</td>
                  <td class="p-4 text-right tabular-nums">{formatPct(o.interest, 2)} <span class="text-[var(--color-neutral-550)]">a year</span></td>
                  <td class="p-4 text-right">{date(o.maturity)}</td>
                  <td class="p-4 text-right"><a href={o.href} target="_blank" rel="noopener noreferrer" class="inline-flex rounded-full bg-[var(--color-brand-deep-blue)] hover:bg-[var(--color-brand-swiss)] text-white font-bold px-5 py-2.5 transition-colors">{c.rates.cta}</a></td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        <div class="md:hidden grid gap-3">
          {options.map((o) => (
            <a href={o.href} target="_blank" rel="noopener noreferrer" class="rounded-2xl border border-[var(--color-gray-20)] bg-white p-5 flex flex-col gap-2">
              <span class="flex justify-between items-center"><span class="inline-flex items-center gap-2"><span class="h-7 w-7 shrink-0 rounded-full bg-[var(--color-gray-10)] ring-1 ring-[var(--color-gray-20)] overflow-hidden grid place-items-center">{coin(o.symbol) ? <img src={`/images/coins/${coin(o.symbol)}`} alt="" loading="lazy" class="h-full w-full object-cover" /> : <span class="text-[10px] font-bold">{o.symbol.slice(0, 3)}</span>}</span><span class="font-black text-[var(--color-brand-deep-blue)]">{o.symbol}</span></span><span class="ty-xs text-[var(--color-neutral-550)]">{c.rates.cols.maturity} {date(o.maturity)}</span></span>
              <span class="grid grid-cols-2 ty-body-3">
                <span><span class="block ty-2xs text-[var(--color-neutral-550)]">{c.rates.cols.ltv}</span><b>{formatPct(o.ltv, 0)}</b></span>
                <span><span class="block ty-2xs text-[var(--color-neutral-550)]">{c.rates.cols.rate}</span><b>{formatPct(o.interest, 2)}</b> a year</span>
              </span>
            </a>
          ))}
        </div>
        <div class="mt-4 flex flex-wrap items-start justify-between gap-3">
          <dl class="m-0 ty-xs text-[var(--color-neutral-550)] max-w-[44rem] grid gap-1">
            <div><dt class="inline font-bold text-[var(--color-neutral-600)]">{c.rates.cols.ltv}:</dt> <dd class="inline m-0">{c.rates.defs.ltv}</dd></div>
            <div><dt class="inline font-bold text-[var(--color-neutral-600)]">{c.rates.cols.rate}:</dt> <dd class="inline m-0">{c.rates.defs.rate}</dd></div>
            <div><dt class="inline font-bold text-[var(--color-neutral-600)]">{c.rates.cols.maturity}:</dt> <dd class="inline m-0">{c.rates.defs.maturity}</dd></div>
          </dl>
          {all.length > options.length && <a href="https://app.frankencoin.com/mint" target="_blank" rel="noopener noreferrer" class="font-bold ty-body-3 text-[var(--color-brand-swiss)]">{c.rates.all.replace("{n}", String(all.length))} →</a>}
        </div>
      </>
    )}
  </LPSection>

  <LPSection id="example" title={c.example.title} subtitle={c.example.subtitle} accent>
    <div class="overflow-hidden rounded-2xl border border-[var(--color-gray-20)] bg-white">
      <table class="w-full ty-body-3">
        <tbody>
          {c.example.rows.map((r: any, i: number) => (
            <tr class={i > 0 ? "border-t border-[var(--color-gray-20)]" : ""}>
              <th scope="row" class="p-4 md:p-5 text-left align-top font-bold text-[var(--color-neutral-600)] w-[11rem] md:w-[14rem]">{r.label}</th>
              <td class="p-4 md:p-5 align-top">
                <span class="block ty-body-2 font-black text-[var(--color-brand-deep-blue)] tabular-nums">{r.value}</span>
                <span class="block mt-1 text-[var(--color-neutral-650)]">{r.note}</span>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <p class="mt-4 ty-xs text-[var(--color-neutral-550)] m-0">{c.example.note}</p>
  </LPSection>

  <LPSection title={c.faqHead.title} split><FaqList items={c.faq} /></LPSection>
  <CtaBand {...c.cta} />
  <StickyCTA label={c.sticky.label} sub={c.sticky.sub} href="/use-cases/borrow#rates" />
</Base>
