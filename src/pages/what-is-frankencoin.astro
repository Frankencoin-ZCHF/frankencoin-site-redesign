---
/* /what-is-frankencoin — the plain-language explainer. Copy: content/en/what-is-frankencoin.json */
import Base from "../layouts/Base.astro";
import LPHero from "../components/LP/LPHero.astro";
import LPSection from "../components/LP/LPSection.astro";
import Figures from "../components/LP/Figures.astro";
import ProseRows from "../components/LP/ProseRows.astro";
import CtaBand from "../components/LP/CtaBand.astro";
import { getLanguageFromURL, loadContent } from "../utils/i18n";
import { getTransparency } from "../utils/liveStats";
import { formatAmount } from "../utils/fcsStats";

export const prerender = false;
const lang = getLanguageFromURL(Astro.url.pathname);
const c = await loadContent<any>("what-is-frankencoin", lang);
const t = await getTransparency();
const ratio = t.supply && t.collateralChf ? `${(t.collateralChf / t.supply).toFixed(2)}×` : "—";
Astro.response.headers.set("Cache-Control", "public, max-age=300, s-maxage=300");
---

<Base>
  <LPHero title={c.header.title} subtitle={c.header.subtitle} primary={c.header.cta} secondary={{ label: "How it works", href: "/how-it-works" }}>
    <Figures slot="aside" items={[
      { ...c.figures.supply, value: formatAmount(t.supply) },
      { ...c.figures.ratio, value: ratio },
      { ...c.figures.types, value: String(t.collateral.length) },
      { ...c.figures.since, value: "2023" },
    ]} />
  </LPHero>

  <LPSection title={c.pillarsHead.title}>
    <div class="grid sm:grid-cols-3 gap-4">
      {c.features.map((f: any) => (
        <div class="rounded-3xl border border-[var(--color-gray-20)] bg-white p-6 md:p-7 flex flex-col gap-4">
          <img src={f.image} alt="" width="48" height="48" class="h-12 w-12" loading="lazy" />
          <h3 class="text-balance ty-title-3 font-black text-[var(--color-brand-deep-blue)] m-0">{f.title}</h3>
          <p class="ty-body-3 text-[var(--color-neutral-650)] m-0">{f.description}</p>
        </div>
      ))}
    </div>
  </LPSection>

  <LPSection title={c.introHead.title} accent>
    <ProseRows rows={c.introduction.map((i: any) => ({ title: i.title, body: i.description, cta: i.cta }))} />
  </LPSection>

  <CtaBand {...c.cta} />
</Base>
