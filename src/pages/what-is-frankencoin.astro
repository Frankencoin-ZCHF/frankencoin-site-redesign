---
import Section from "../components/Layout/Section.astro";
import SectionHeader from "../components/Layout/SectionHeader.astro";
import Base from "../layouts/Base.astro";
import LPHero from "../components/LP/LPHero.astro";
import LPSection from "../components/LP/LPSection.astro";
import CtaBand from "../components/LP/CtaBand.astro";
import Figures from "../components/LP/Figures.astro";
import { getLanguageFromURL, loadContent } from "../utils/i18n";
import FlexStack from "../components/Layout/FlexStack.astro";

const currentLang = getLanguageFromURL(Astro.url.pathname);
const whatIsFrankencoin = await loadContent("what-is-frankencoin", currentLang);
const featureCols = (whatIsFrankencoin as any).features.length === 3 ? "grid-cols-1 sm:grid-cols-3" : "grid-cols-1 sm:grid-cols-2";
---

<Base>
  <LPHero eyebrow={whatIsFrankencoin.header.eyebrow ?? "About Frankencoin"} title={whatIsFrankencoin.header.title} subtitle={whatIsFrankencoin.header.subtitle} primary={Array.isArray(whatIsFrankencoin.header.cta) ? whatIsFrankencoin.header.cta[0] : whatIsFrankencoin.header.cta} secondary={{ label: "How it works", href: "/how-it-works" }}>
    <div slot="aside" class:list={["grid gap-px overflow-hidden", featureCols, "rounded-3xl border border-white/70 bg-[var(--color-gray-20)]/60 backdrop-blur-md shadow-[0_10px_40px_-15px_rgba(9,47,98,0.35)]"]}>
      {whatIsFrankencoin.features.map((feature: any) => (
        <div class="bg-white/80 p-4 sm:p-5 flex flex-row sm:flex-col items-center sm:items-start gap-3">
          <img src={feature.image} alt="" width="44" height="44" class="h-11 w-11" />
          <span class="font-mono text-[11px] uppercase tracking-[0.2em] text-[var(--color-brand-deep-blue)]">{feature.title}</span>
        </div>
      ))}
    </div>
  </LPHero>

  <Section
    id="what-is-frankencoin-introduction"
    margin=""
    pad="none"
  >
    <FlexStack direction="col" gap="40px" align="center">
      {
        whatIsFrankencoin.introduction.map((feature) => (
          <div class="flex flex-col gap-4  md:flex-row justify-between">
            <div class="w-full md:w-1/2">
              <h2 class="text-[26px] sm:text-[32px] leading-[1.05] font-black tracking-[-0.03em] text-[var(--color-brand-deep-blue)] m-0">{feature.title}</h2>
            </div>
            <div class="w-full md:w-1/2">
              <p
                class="ty-body-1"
                set:html={feature.description.replace(/\n/g, "<br>")}
              />
            </div>
          </div>
        ))
      }
    </FlexStack>
  </Section>
  <CtaBand title="Put your money in Swiss francs." body="Three steps, about ten minutes. You keep your own keys." primary={{ label: "Start now", href: "https://app.frankencoin.com/savings" }} secondary={{ label: "How it works", href: "/how-it-works" }} />
</Base>
