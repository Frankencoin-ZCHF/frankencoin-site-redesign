---
/* /ecosystem — services built on ZCHF, grouped by task. Copy: content/en/ecosystem.json (the home page reads `tabs` for its logo strip). */
import Base from "../layouts/Base.astro";
import LPHero from "../components/LP/LPHero.astro";
import LPSection from "../components/LP/LPSection.astro";
import { getLanguageFromURL, getLocalizedPath, loadContent } from "../utils/i18n";

const lang = getLanguageFromURL(Astro.url.pathname);
const en = await loadContent<any>("ecosystem", "en");
const local = await loadContent<any>("ecosystem", lang);
// German copy predates today's keys: fall back to English per key.
const c = { ...en, ...local, header: { ...en.header, ...local.header } };

const catOf = (t: any) => t.category ?? t.badge ?? "Other";
const order: string[] = [...(c.categories ?? [])];
for (const t of c.tabs) if (!order.includes(catOf(t))) order.push(catOf(t));
const groups = order.map((name) => ({ name, items: c.tabs.filter((t: any) => catOf(t) === name) })).filter((g) => g.items.length > 0);
const localHref = (h: string) => (h.startsWith("/") ? getLocalizedPath(h, lang) : h);
---

<Base>
  <LPHero compact title={c.header.title} subtitle={c.header.subtitle} />

  {groups.map((g, i) => (
    <LPSection id={g.name.toLowerCase().replace(/[^a-z0-9]+/g, "-")} title={g.name} split accent={i % 2 === 1}>
      <div class="grid sm:grid-cols-2 gap-4">
        {g.items.map((t: any) => (
          <a href={t.href} target="_blank" rel="noopener noreferrer" class="group relative overflow-hidden flex flex-col rounded-3xl border border-[var(--color-gray-20)] bg-white p-6 md:p-7 hover:-translate-y-0.5 hover:shadow-xl transition-all">
            <span class="halftone-dots absolute inset-0 text-[#5bb8dc]/40 opacity-0 group-hover:opacity-100 transition-opacity pointer-events-none"></span>
            <div class="relative h-12 flex items-center mb-4">
              <img src={t.image} alt={t.imageAlt ?? t.name} class="max-h-10 max-w-[160px] object-contain" loading="lazy" />
            </div>
            <h3 class="relative text-balance ty-title-3 font-black text-[var(--color-brand-deep-blue)] m-0">{t.name}</h3>
            <p class="relative mt-2 ty-body-3 text-[var(--color-neutral-650)] flex-1 m-0 [overflow-wrap:anywhere]">{t.description}</p>
            <p class="relative mt-5 ty-body-3 font-bold text-[var(--color-brand-swiss)] m-0">{t.linkLabel ?? new URL(t.href).hostname} ↗</p>
          </a>
        ))}
      </div>
      {i === 0 && c.useCases && (
        <p class="mt-6 ty-body-3 text-[var(--color-neutral-650)] m-0">{c.useCases.text} <a href={localHref(c.useCases.href)} class="font-bold text-[var(--color-brand-swiss)] hover:underline">{c.useCases.linkLabel} →</a></p>
      )}
    </LPSection>
  ))}

  <LPSection id="submit" title={c.submit.title} split accent={groups.length % 2 === 1}>
    <p class="ty-body-1 text-pretty text-[var(--color-neutral-650)] m-0">{c.submit.text}</p>
    <div class="mt-6 flex flex-wrap items-center gap-4">
      <a href={c.submit.cta.href} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 rounded-full bg-[var(--color-brand-deep-blue)] hover:bg-[var(--color-brand-swiss)] text-white font-bold ty-body-2 px-6 py-3.5 transition-colors">{c.submit.cta.label} ↗</a>
      {c.submit.fileHref && <a href={c.submit.fileHref} target="_blank" rel="noopener noreferrer" class="ty-body-3 font-mono text-[var(--color-brand-deep-blue)] hover:underline">{c.submit.fileLabel}</a>}
    </div>
  </LPSection>
</Base>
