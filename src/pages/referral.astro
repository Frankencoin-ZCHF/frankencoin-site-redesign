---
/* /referral — referral program on the savings contract (up to 25% of interest). Copy: content/en/referral.json */
import Base from "../layouts/Base.astro";
import LPHero from "../components/LP/LPHero.astro";
import LPSection from "../components/LP/LPSection.astro";
import FeatureGrid from "../components/LP/FeatureGrid.astro";
import { getLanguageFromURL, loadContent } from "../utils/i18n";
import { getCalcData } from "../utils/calcStats";

export const prerender = false;
const lang = getLanguageFromURL(Astro.url.pathname);
const c = await loadContent<any>("referral", lang);
const d = await getCalcData();
const b = c.builder;
const init = JSON.stringify({ rate: d.current.rate ?? 0, locale: lang === "de" ? "de-CH" : "en-CH" });
---

<Base title={c.meta.title} description={c.meta.description}>
  <LPHero eyebrow={c.hero.eyebrow} title={c.hero.title} subtitle={c.hero.subtitle} primary={c.hero.primary} secondary={c.hero.secondary} />
  <LPSection title={c.how.title}><FeatureGrid items={c.how.cards} /></LPSection>

  <LPSection id="link" title={b.title} accent>
    <div
      class="grid lg:grid-cols-2 gap-6 rounded-2xl border border-[var(--color-gray-20)] bg-[var(--color-white)] p-5 sm:p-8"
      x-data={`{ cfg: ${init}, address: "", fee: 10, saved: 100000, copied: false,
        get valid() { return /^0x[0-9a-fA-F]{40}$/.test(this.address.trim()) },
        get link() { return this.valid ? "https://app.frankencoin.com/savings?referrer=" + this.address.trim() + "&referralFeePPM=" + Math.round(this.fee * 10000) : "" },
        get earn() { return this.saved * this.cfg.rate * this.fee / 100 },
        fmt(n) { return new Intl.NumberFormat(this.cfg.locale, { maximumFractionDigits: 0 }).format(n) },
        copy() { navigator.clipboard?.writeText(this.link); this.copied = true; setTimeout(() => this.copied = false, 1500) } }`}
    >
      <div class="flex flex-col gap-5 min-w-0">
        <label class="flex flex-col gap-2">
          <span class="ty-xs tracking-wider font-bold text-[var(--color-neutral-600)]">{b.address.toUpperCase()}</span>
          <input x-model="address" placeholder="0x…" spellcheck="false" class="w-full min-w-0 rounded-xl border border-[var(--color-gray-20)] px-4 py-3 font-mono ty-body-3 outline-none focus:border-[var(--color-brand-swiss)]" />
          <span x-show="address && !valid" class="ty-xs text-[#e02523]">{b.invalid}</span>
        </label>
        <label class="flex flex-col gap-2">
          <span class="flex justify-between ty-xs tracking-wider font-bold text-[var(--color-neutral-600)]"><span>{b.fee.toUpperCase()}</span><span x-text="fee + '%'"></span></span>
          <input type="range" min="1" max="25" step="1" x-model.number="fee" class="w-full accent-[var(--color-brand-swiss)]" />
          <span class="ty-xs text-[var(--color-neutral-550)]">{b.feeHint}</span>
        </label>
        <div class="flex flex-col gap-2">
          <span class="ty-xs tracking-wider font-bold text-[var(--color-neutral-600)]">{b.link.toUpperCase()}</span>
          <div class="flex min-w-0 rounded-xl border border-[var(--color-gray-20)] overflow-hidden">
            <code class="flex-1 min-w-0 px-4 py-3 ty-xs font-mono break-all text-[var(--color-neutral-700)]" x-text="link || '—'"></code>
            <button type="button" @click="copy()" :disabled="!valid" class="px-4 font-bold ty-body-3 bg-[var(--color-brand-deep-blue)] text-white disabled:opacity-40" x-text={`copied ? '${b.copied}' : '${b.copy}'`}></button>
          </div>
        </div>
      </div>
      <div class="flex flex-col gap-3 min-w-0">
        <div class="rounded-2xl bg-[var(--color-brand-deep-blue)] text-white p-6">
          <p class="ty-xs tracking-wider font-bold opacity-80">{b.earnTitle.toUpperCase()}</p>
          <label class="flex items-center gap-2 mt-3 ty-body-3">
            <span>{b.referred}</span>
            <input type="number" min="0" step="1000" x-model.number="saved" class="w-32 rounded-lg bg-white/10 border border-white/30 px-2 py-1 text-white" />
            <span>ZCHF</span>
          </label>
          <p class="mt-3 ty-body-3 opacity-90">{b.perYear}</p>
          <p class="text-[40px] font-black leading-none mt-1"><span x-text="fmt(earn)"></span> ZCHF</p>
        </div>
        <p class="ty-2xs text-[var(--color-neutral-550)]">{c.note}</p>
      </div>
    </div>
  </LPSection>

  <LPSection title={c.fair.title}><FeatureGrid items={c.fair.items} /></LPSection>
  <LPSection title={c.who.title} accent><FeatureGrid items={c.who.items} /></LPSection>
</Base>
