---
/* /governance — how proposals, review and vetoes work. Copy: content/en/governance.json (German file still has the legacy shape; new keys fall back to English) */
import Base from "../layouts/Base.astro";
import LPHero from "../components/LP/LPHero.astro";
import LPSection from "../components/LP/LPSection.astro";
import FeatureGrid from "../components/LP/FeatureGrid.astro";
import ProseRows from "../components/LP/ProseRows.astro";
import Steps from "../components/Steps/Steps.astro";
import CtaBand from "../components/LP/CtaBand.astro";
import { getLanguageFromURL, loadContent } from "../utils/i18n";

export const prerender = false;
const lang = getLanguageFromURL(Astro.url.pathname);
const en = await loadContent<any>("governance", "en");
const local = await loadContent<any>("governance", lang);
const c = { ...en, ...local };
Astro.response.headers.set("Cache-Control", "public, max-age=300, s-maxage=300");
---

<Base>
  <LPHero compact title={c.hero.title} subtitle={c.hero.subtitle} primary={c.hero.primary} secondary={c.hero.secondary} />
  <LPSection title={c.process.title}><Steps steps={c.process.steps} /></LPSection>
  <LPSection title={c.covers.title} accent><FeatureGrid items={c.covers.items} cols={3} /></LPSection>
  <LPSection><ProseRows rows={[c.power, c.fcs]} /></LPSection>
  <CtaBand {...c.end} />
</Base>
