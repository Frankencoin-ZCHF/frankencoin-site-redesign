---
/** Closing call to action on a dark band. */
import { getLanguageFromURL, getLocalizedPath } from "../../utils/i18n";
interface Cta { label: string; href: string }
const { title, body, primary, secondary } = Astro.props as { title: string; body?: string; primary: Cta; secondary?: Cta };
const lang = getLanguageFromURL(Astro.url.pathname);
const href = (h: string) => (h.startsWith("/") ? getLocalizedPath(h, lang) : h);
const ext = (h: string) => (h.startsWith("http") ? { target: "_blank", rel: "noopener noreferrer" } : {});
---

<section class="py-14 md:py-20 bg-[var(--color-white)]">
  <div class="mx-auto max-w-3xl px-[var(--spacing-l)]">
    <div class="rounded-3xl bg-[var(--color-brand-deep-blue)] text-white p-8 md:p-12 flex flex-col gap-4 items-center text-center">
      <h2 class="ty-title-1 font-black m-0">{title}</h2>
      {body && <p class="ty-body-2 opacity-90">{body}</p>}
      <div class="flex flex-wrap justify-center gap-3 mt-2">
        <a href={href(primary.href)} {...ext(primary.href)} class="inline-flex items-center rounded-full bg-[var(--color-brand-swiss)] hover:bg-white hover:text-[var(--color-brand-deep-blue)] text-white font-bold ty-body-2 px-6 py-3.5 transition-colors">{primary.label}</a>
        {secondary && <a href={href(secondary.href)} {...ext(secondary.href)} class="inline-flex items-center rounded-full border border-white/60 text-white font-bold ty-body-2 px-6 py-3.5 hover:bg-white/10">{secondary.label}</a>}
      </div>
    </div>
  </div>
</section>
