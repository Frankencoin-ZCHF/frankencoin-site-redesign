---
/** Live figures as a plain white panel. One item spans the full width; two or more sit in columns. */
interface Fig { label: string; value: string; unit?: string }
const { items, cols = 2 } = Astro.props as { items: Fig[]; cols?: 2 | 4 };
---

<dl class={`grid ${items.length === 1 ? "grid-cols-1" : "grid-cols-2"} ${cols === 4 ? "lg:grid-cols-4" : ""} gap-px overflow-hidden rounded-2xl border border-[var(--color-gray-20)] bg-[var(--color-gray-20)] shadow-[0_8px_24px_-16px_rgba(9,47,98,0.25)] m-0`}>
  {items.map((f) => (
    <div class="bg-white p-4 md:p-6 min-w-0">
      <dt class="ty-xs text-[var(--color-neutral-550)]">{f.label}</dt>
      <dd class="m-0 mt-1 text-[24px] sm:text-[32px] font-black tracking-tight text-[var(--color-brand-deep-blue)] leading-none tabular-nums break-words">{f.value}</dd>
      {f.unit && <dd class="m-0 mt-1 ty-xs text-[var(--color-neutral-550)]">{f.unit}</dd>}
    </div>
  ))}
</dl>
