---
/** Plain landing-page section: optional eyebrow/title/subtitle, then content. */
interface Props { id?: string; eyebrow?: string; title?: string; subtitle?: string; accent?: boolean; narrow?: boolean }
const { id, eyebrow, title, subtitle, accent = false, narrow = false } = Astro.props as Props;
---

<section id={id} class={`py-14 md:py-20 scroll-mt-20 ${accent ? "bg-[var(--color-gray-10)]" : "bg-[var(--color-white)]"}`}>
  <div class={`mx-auto px-[var(--spacing-l)] ${narrow ? "max-w-3xl" : "max-w-6xl"}`}>
    {(eyebrow || title || subtitle) && (
      <div class="mb-8 md:mb-10 max-w-3xl">
        {eyebrow && <p class="ty-subtitle">{eyebrow.toUpperCase()}</p>}
        {title && <h2 class="ty-title-1 text-[var(--color-brand-deep-blue)] mt-1 m-0">{title}</h2>}
        {subtitle && <p class="ty-body-2 text-[var(--color-neutral-650)] mt-3">{subtitle}</p>}
      </div>
    )}
    <slot />
  </div>
</section>
