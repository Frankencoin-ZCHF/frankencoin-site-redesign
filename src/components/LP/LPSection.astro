---
/** Landing-page section in the home style: mono eyebrow, display title, generous spacing. */
interface Props { id?: string; eyebrow?: string; title?: string; subtitle?: string; accent?: boolean; narrow?: boolean }
const { id, eyebrow, title, subtitle, accent = false, narrow = false } = Astro.props as Props;
---

<section id={id} class={`py-16 md:py-24 scroll-mt-20 ${accent ? "bg-[var(--color-gray-10)]" : "bg-[var(--color-white)]"}`}>
  <div class={`mx-auto px-[var(--spacing-l)] ${narrow ? "max-w-3xl" : "max-w-7xl"}`}>
    {(eyebrow || title || subtitle) && (
      <div class="mb-10 md:mb-12 max-w-3xl">
        {title && <h2 class="text-balance text-[30px] sm:text-[40px] lg:text-[46px] leading-[1.04] font-black tracking-[-0.03em] text-[var(--color-brand-deep-blue)] m-0">{title}</h2>}
        {subtitle && <p class="mt-4 text-pretty ty-body-1 text-[var(--color-neutral-650)]">{subtitle}</p>}
      </div>
    )}
    <slot />
  </div>
</section>
