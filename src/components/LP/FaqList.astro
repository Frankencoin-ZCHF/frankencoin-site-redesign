---
/** Collapsible questions (Alpine). */
const { items } = Astro.props as { items: { q: string; a: string }[] };
const md = (t: string) => t.replace(/\[([^\]]+)\]\(([^)]+)\)/g, '<a href="$2" class="font-bold text-[var(--color-blue-39)] hover:underline">$1</a>');
---

<div class="divide-y divide-[var(--color-gray-20)] border border-[var(--color-gray-20)] rounded-3xl px-6 md:px-8 py-2 bg-[var(--color-white)]">
  {items.map((f) => (
    <div x-data="{ open: false }" class="py-4">
      <button class="w-full flex justify-between items-center gap-4 text-left" x-on:click="open = !open" :aria-expanded="open.toString()">
        <span class="ty-body-2 font-bold text-[var(--color-brand-deep-blue)]">{f.q}</span>
        <span aria-hidden="true" class="text-2xl leading-none transition-transform" :class="open ? 'rotate-45' : ''">+</span>
      </button>
      <p x-show="open" x-transition class="mt-3 ty-body-3 text-[var(--color-neutral-650)]" set:html={md(f.a)} />
    </div>
  ))}
</div>
