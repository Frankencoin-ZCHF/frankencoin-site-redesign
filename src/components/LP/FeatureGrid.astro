---
/** Grid of short cards. Items with `href` become links. */
import { getLanguageFromURL, getLocalizedPath } from "../../utils/i18n";
interface Item { title: string; description: string; href?: string; cta?: string; eyebrow?: string }
interface Props { items: Item[]; cols?: 2 | 3 | 4 }
const { items, cols = 3 } = Astro.props as Props;
const lang = getLanguageFromURL(Astro.url.pathname);
const href = (h: string) => (h.startsWith("/") ? getLocalizedPath(h, lang) : h);
const grid = { 2: "sm:grid-cols-2", 3: "sm:grid-cols-2 lg:grid-cols-3", 4: "sm:grid-cols-2 lg:grid-cols-4" }[cols];
const base = "min-w-0 flex flex-col gap-2 rounded-2xl border border-[var(--color-gray-20)] bg-[var(--color-white)] p-6";
---

<div class={`grid ${grid} gap-4 lg:gap-5`}>
  {items.map((it) => {
    const body = (
      <>
        {it.eyebrow && <span class="ty-xs tracking-wider font-bold text-[var(--color-brand-swiss)]">{it.eyebrow.toUpperCase()}</span>}
        <h3 class="ty-title-3 font-black text-[var(--color-brand-deep-blue)] m-0">{it.title}</h3>
        <p class="ty-body-3 text-[var(--color-neutral-650)] flex-1 [overflow-wrap:anywhere]">{it.description}</p>
        {it.href && <span class="ty-body-3 font-bold text-[var(--color-blue-39)] group-hover:text-[var(--color-brand-swiss)]">{it.cta ?? "Learn more"} →</span>}
      </>
    );
    return it.href ? (
      <a href={href(it.href)} target={it.href.startsWith("http") ? "_blank" : undefined} rel={it.href.startsWith("http") ? "noopener noreferrer" : undefined} class={`group ${base} hover:border-[var(--color-brand-swiss)] hover:shadow-md transition-all`}>{body}</a>
    ) : (
      <div class={base}>{body}</div>
    );
  })}
</div>
