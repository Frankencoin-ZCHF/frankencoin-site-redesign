---
/**
 * Answers one question on the Save page: why ZCHF instead of T-bills? A static $10,000-since-2000
 * comparison (T-bills rolled quarterly vs francs at Swiss cash rates), then four reasons. Same maths
 * as DollarTruth, server-rendered from src/data/dollar-history.json and the live rate.
 */
import history from "../../data/dollar-history.json";
import { getLanguageFromURL, loadContent } from "../../utils/i18n";
import { getUsdChfHistory } from "../../utils/liveStats";

interface Props {
  /** Live ZCHF savings rate, already formatted ("3.5%"). */
  rate: string;
  year?: number;
  amount?: number;
}
const { rate, year = 2000, amount = 10000 } = Astro.props;
const lang = getLanguageFromURL(Astro.url.pathname);
const c = (await loadContent<any>("save-in-chf", lang)).tbills;
const fx = await getUsdChfHistory();
const rows = history.rows;
const last = rows[rows.length - 1];
const liveRate = fx.points.length ? fx.points[fx.points.length - 1][1] : last.usdchf;
const i = Math.max(0, rows.findIndex((r) => r.year === year));
const start = rows[i];
let tb = amount, chf = amount * start.usdchf, tbSum = 0;
for (let k = i; k < rows.length; k++) { tb *= 1 + rows[k].tbill / 100; chf *= 1 + rows[k].chf3m / 100; tbSum += rows[k].tbill; }
const deflate = start.usCpi / last.usCpi;
const chfUsd = chf / liveRate;
const need = amount / deflate;
const tbReal = tb * deflate, chfReal = chfUsd * deflate;
const fxLoss = 1 - liveRate / start.usdchf;
const tbillAvg = tbSum / (rows.length - i);
const locale = lang === "de" ? "de-CH" : "en-US";
const usd = (v: number) => "$" + new Intl.NumberFormat(locale, { maximumFractionDigits: 0 }).format(Math.round(v));
const chfF = (v: number) => new Intl.NumberFormat("de-CH", { maximumFractionDigits: 0 }).format(Math.round(v)) + " CHF";
const pct = (v: number, d = 0) => `${(v * 100).toFixed(d)}%`;
const signed = (v: number) => `${v >= 0 ? "+" : "−"}${pct(Math.abs(v))}`;
const t = (s: string) => s.replaceAll("{amount}", usd(amount)).replaceAll("{year}", String(year)).replace("{chf}", chfF(amount * start.usdchf)).replace("{need}", usd(need)).replace("{tbillAvg}", pct(tbillAvg / 100, 1)).replace("{fxLoss}", pct(fxLoss)).replace("{rate}", rate);
const [l1, l2] = c.title.split("|");
const max = Math.max(tb, chfUsd, need);
const bars = [
  { label: t(c.tbill.label), value: tb, real: tbReal / amount - 1, note: t(c.tbill.note), color: "#ffd166" },
  { label: t(c.chf.label), value: chfUsd, real: chfReal / amount - 1, note: t(c.chf.note), color: "#7ee2a8" },
];
---

<section class="relative overflow-hidden bg-[var(--color-brand-deep-blue)] text-white py-20 md:py-28">
  <div class="halftone-dots absolute inset-0 opacity-[0.12] pointer-events-none" aria-hidden="true"></div>
  <div class="relative mx-auto max-w-7xl px-[var(--spacing-l)]">
    <h2 class="text-balance text-[34px] sm:text-[48px] lg:text-[60px] leading-[1.02] font-black tracking-[-0.03em] m-0 max-w-4xl">
      {l1}<br /><span class="text-[#5bb8dc]">{l2}</span>
    </h2>
    <p class="mt-5 text-pretty ty-body-1 text-white/75 max-w-[40rem]">{t(c.subtitle)}</p>

    <div class="mt-10 rounded-3xl border border-white/10 bg-[#0e3a72] p-6 md:p-8 grid gap-6">
      {bars.map((b) => (
        <div class="grid md:grid-cols-[minmax(0,1fr)_auto] gap-x-8 gap-y-2 items-end">
          <div class="min-w-0">
            <p class="ty-body-3 font-bold text-white/90">{b.label}</p>
            <div class="mt-3 h-3 rounded-full bg-white/10 overflow-hidden">
              <div class="h-full rounded-full" style={`width:${(b.value / max) * 100}%;background:${b.color}`}></div>
            </div>
            <p class="mt-2 ty-body-3 text-white/70">{b.note}</p>
          </div>
          <div class="md:text-right">
            <p class="text-[36px] md:text-[44px] font-black leading-none tabular-nums">{usd(b.value)}</p>
            <p class="mt-1 font-bold" style={`color:${b.real >= 0 ? "#7ee2a8" : "#ff9a9a"}`}>{signed(b.real)} <span class="ty-body-3 font-medium text-white/65">{b.real >= 0 ? c.chf.tag : c.tbill.tag}</span></p>
          </div>
        </div>
      ))}
      <p class="ty-body-3 text-white/60 border-t border-white/10 pt-4">{t(c.need)}</p>
    </div>

    <div class="mt-6 grid sm:grid-cols-2 lg:grid-cols-4 gap-4">
      {c.reasons.map((r: any, n: number) => (
        <div class="rounded-3xl border border-white/10 bg-[#0e3a72] p-6 flex flex-col">
          <p class="ty-body-3 font-bold text-[#5bb8dc]">0{n + 1}</p>
          <h3 class="mt-3 text-balance ty-title-3 font-black m-0">{r.title}</h3>
          <p class="mt-2 ty-body-3 text-white/70 flex-1">{t(r.body)}</p>
          {r.href && <a href={r.href} class="mt-4 inline-flex items-center gap-1 font-bold text-[#5bb8dc] hover:underline">{r.cta} →</a>}
        </div>
      ))}
    </div>
    <p class="mt-5 ty-2xs text-white/45 max-w-4xl">{c.source}</p>
  </div>
</section>
