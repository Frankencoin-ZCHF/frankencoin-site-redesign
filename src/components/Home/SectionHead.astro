---
/** Section heading in the home style: optional mono eyebrow, tight display title. */
const { eyebrow, title, subtitle, center = false } = Astro.props as { eyebrow?: string; title: string; subtitle?: string; center?: boolean };
const [l1, l2] = title.split("|");
// A one-line title made of several sentences wraps between sentences, never inside one.
const parts = l2 ? [] : l1.split(/(?<=[.!?])\s+/);
---

<div class={`mb-8 md:mb-12 ${center ? "text-center mx-auto" : ""} max-w-3xl`}>
  <h2 class={`text-balance text-[30px] sm:text-[36px] lg:text-[40px] leading-[1.08] font-black tracking-[-0.025em] text-[var(--color-brand-deep-blue)] m-0`}>{l2 ? <>{l1}<br />{l2}</> : parts.length > 1 ? parts.map((t, i) => <><span class="inline-block">{t}</span>{i < parts.length - 1 ? " " : ""}</>) : l1}</h2>
  {subtitle && <p class="mt-3 ty-body-1 text-[var(--color-neutral-650)]">{subtitle}</p>}
</div>
