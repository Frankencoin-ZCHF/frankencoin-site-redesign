---
/**
 * Halftone "mist" drifting above the hero mountains: a grid of square dots whose size follows
 * animated value noise, in the teal of the hero image. The pointer brightens the dots around it.
 * Canvas 2D, no dependencies. Pauses off-screen; draws one still frame for reduced motion.
 */
---

<canvas data-halftone class="absolute inset-0 w-full h-full pointer-events-none" aria-hidden="true"></canvas>

<script>
  function init(canvas: HTMLCanvasElement) {
    const ctx = canvas.getContext("2d");
    if (!ctx) return;
    const host = canvas.parentElement as HTMLElement;
    const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    const CELL = 9;
    let w = 0, h = 0, cols = 0, rows = 0, visible = true, raf = 0, last = 0;
    const pointer = { x: -9999, y: -9999, a: 0 };

    // 2D value noise with smooth interpolation, two octaves.
    const P = new Uint8Array(512);
    for (let i = 0; i < 256; i++) P[i] = i;
    for (let i = 255; i > 0; i--) { const j = (Math.random() * (i + 1)) | 0; [P[i], P[j]] = [P[j], P[i]]; }
    for (let i = 0; i < 256; i++) P[i + 256] = P[i];
    const hash = (x: number, y: number) => P[(P[x & 255] + y) & 511] / 255;
    const smooth = (t: number) => t * t * (3 - 2 * t);
    function noise(x: number, y: number) {
      const xi = Math.floor(x), yi = Math.floor(y), xf = x - xi, yf = y - yi;
      const a = hash(xi, yi), b = hash(xi + 1, yi), c = hash(xi, yi + 1), d = hash(xi + 1, yi + 1);
      const u = smooth(xf), v = smooth(yf);
      return a + (b - a) * u + (c - a) * v + (a - b - c + d) * u * v;
    }
    const fbm = (x: number, y: number) => noise(x, y) * 0.65 + noise(x * 2.1, y * 2.1) * 0.35;

    function resize() {
      const r = host.getBoundingClientRect();
      w = Math.ceil(r.width); h = Math.ceil(r.height);
      canvas.width = w; canvas.height = h; // 1 dot = 1 CSS px is crisp enough for a dither look
      cols = Math.ceil(w / CELL); rows = Math.ceil(h / CELL);
    }

    function draw(t: number) {
      ctx!.clearRect(0, 0, w, h);
      const time = t * 0.00004;
      const mobile = w < 768;
      for (let j = 0; j < rows; j++) {
        const yn = j / rows;
        // Mist lives in a band above the mountains and fades out at the top and into the image.
        const band = Math.max(0, 1 - Math.abs(yn - (mobile ? 0.5 : 0.46)) / (mobile ? 0.22 : 0.26));
        if (band <= 0) continue;
        for (let i = 0; i < cols; i++) {
          const xn = i / cols;
          // Keep the headline area clean: fade out towards the left on desktop.
          const side = mobile ? 0.55 : Math.min(1, Math.max(0.12, (xn - 0.32) / 0.3));
          let v = fbm(i * 0.045 + time * 18, j * 0.07 - time * 6);
          v = Math.max(0, (v - 0.42) / 0.5) * band * side;
          const x = i * CELL, y = j * CELL;
          if (pointer.a > 0) {
            const dx = x - pointer.x, dy = y - pointer.y, d = Math.sqrt(dx * dx + dy * dy);
            if (d < 170) v += (1 - d / 170) * 0.55 * pointer.a * band;
          }
          if (v < 0.05) continue;
          const s = Math.min(CELL - 2, 1 + v * (CELL - 2));
          const alpha = Math.min(0.75, 0.12 + v * 0.7);
          ctx!.fillStyle = v > 0.55 ? `rgba(26,156,200,${alpha})` : `rgba(91,184,220,${alpha})`;
          ctx!.fillRect(x + (CELL - s) / 2, y + (CELL - s) / 2, s, s);
        }
      }
    }

    function loop(t: number) {
      raf = requestAnimationFrame(loop);
      if (!visible || t - last < 40) return; // ~25 fps is plenty for slow mist
      last = t;
      pointer.a = Math.max(0, pointer.a - 0.02);
      draw(t);
    }

    resize();
    new ResizeObserver(() => { resize(); if (reduce) draw(0); }).observe(host);
    if (reduce) { draw(0); return; }
    new IntersectionObserver(([e]) => (visible = e.isIntersecting)).observe(host);
    host.addEventListener("pointermove", (e) => {
      const r = canvas.getBoundingClientRect();
      pointer.x = e.clientX - r.left; pointer.y = e.clientY - r.top; pointer.a = 1;
    });
    raf = requestAnimationFrame(loop);
  }
  document.querySelectorAll<HTMLCanvasElement>("canvas[data-halftone]").forEach(init);
</script>
