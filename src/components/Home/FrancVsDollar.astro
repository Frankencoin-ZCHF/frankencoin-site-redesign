---
/**
 * Fifty years of USD/CHF as one static statement: the rate then and now, a line chart, and what
 * $10,000 kept in dollars vs changed into francs in 1971 is worth today. Server-rendered from
 * src/data/dollar-history.json and the live rate.
 */
import history from "../../data/dollar-history.json";
import { getLanguageFromURL, loadContent } from "../../utils/i18n";
import { getUsdChfHistory } from "../../utils/liveStats";

const lang = getLanguageFromURL(Astro.url.pathname);
const c = (await loadContent<any>("save-in-chf", lang)).fifty;
const fx = await getUsdChfHistory();
const rows = history.rows;
const first = rows[0], last = rows[rows.length - 1];
const now = fx.points.length ? fx.points[fx.points.length - 1][1] : last.usdchf;
const amount = 10000;
const loss = 1 - now / first.usdchf;
const real = amount * first.usCpi / last.usCpi;
const chf = amount * first.usdchf;
const chfUsd = chf / now;
const locale = lang === "de" ? "de-CH" : "en-US";
const usd = (v: number) => "$" + new Intl.NumberFormat(locale, { maximumFractionDigits: 0 }).format(Math.round(v));
const chfF = (v: number) => new Intl.NumberFormat("de-CH", { maximumFractionDigits: 0 }).format(Math.round(v)) + " CHF";
const pct = (v: number) => `${Math.round(v * 100)}%`;
const t = (s: string) => s.replace("{then}", first.usdchf.toFixed(2)).replace("{now}", now.toFixed(2)).replace("{loss}", pct(loss)).replaceAll("{amount}", usd(amount)).replace("{real}", usd(real)).replace("{chfUsd}", usd(chfUsd)).replace("{chf}", chfF(chf));
const series = [...rows.map((r) => r.usdchf), now];
const max = Math.max(...series);
const pts = series.map((v, i) => [(i / (series.length - 1)) * 100, 38 - (v / max) * 34] as const);
const line = pts.map(([x, y], i) => `${i ? "L" : "M"}${x.toFixed(2)} ${y.toFixed(2)}`).join(" ");
const [l1, l2] = t(c.title).split("|");
---

<section class="bg-[var(--color-white)] py-20 md:py-28">
  <div class="mx-auto max-w-7xl px-[var(--spacing-l)]">
    <h2 class="text-balance text-[34px] sm:text-[48px] lg:text-[60px] leading-[1.02] font-black tracking-[-0.03em] text-[var(--color-brand-deep-blue)] m-0 max-w-4xl">
      {l1}<br /><span class="text-[#1a9cc8]">{l2}</span>
    </h2>
    <p class="mt-5 text-pretty ty-body-1 text-[var(--color-neutral-650)] max-w-[40rem]">{t(c.subtitle)}</p>

    <div class="mt-10 grid lg:grid-cols-[1.4fr_1fr] gap-6 items-stretch">
      <figure class="m-0 rounded-3xl border border-[var(--color-gray-20)] bg-[var(--color-gray-10)] p-6 md:p-8 flex flex-col">
        <figcaption class="font-mono text-[10px] uppercase tracking-[0.22em] text-[var(--color-neutral-550)]">{c.chartLabel}</figcaption>
        <div class="flex items-baseline gap-3 mt-2">
          <span class="text-[40px] font-black tracking-tight text-[var(--color-brand-deep-blue)] leading-none">{first.usdchf.toFixed(2)}</span>
          <span class="text-[var(--color-neutral-550)]">→</span>
          <span class="text-[40px] font-black tracking-tight text-[#1a9cc8] leading-none">{now.toFixed(2)}</span>
          <span class="ml-2 rounded-full bg-[#ffe4e4] text-[#b42318] font-mono text-[11px] font-bold px-2.5 py-1">−{pct(loss)}</span>
        </div>
        <svg viewBox="0 0 100 40" preserveAspectRatio="none" class="w-full h-40 md:h-56 mt-5 flex-1" role="img" aria-label={c.chartLabel}>
          <path d={`${line} L100 40 L0 40 Z`} fill="rgba(26,156,200,0.12)" />
          <path d={line} fill="none" stroke="#1a9cc8" stroke-width="1.6" vector-effect="non-scaling-stroke" />
        </svg>
        <div class="flex justify-between font-mono text-[10px] text-[var(--color-neutral-550)] mt-1"><span>{first.year}</span><span>{new Date().getFullYear()}</span></div>
      </figure>
      <div class="grid gap-4">
        <div class="rounded-3xl border border-[var(--color-gray-20)] bg-white p-6 flex flex-col">
          <p class="font-mono text-[10px] uppercase tracking-[0.22em] text-[var(--color-neutral-550)]">{t(c.cash.label)}</p>
          <p class="mt-3 text-[40px] font-black tracking-tight text-[var(--color-brand-deep-blue)] leading-none">{t(c.cash.value)}</p>
          <p class="mt-3 ty-body-3 text-[var(--color-neutral-650)]">{t(c.cash.note)}</p>
          <p class="mt-2 font-bold text-[#b42318]">−{pct(1 - real / amount)} <span class="font-mono text-[10px] uppercase tracking-[0.18em] text-[var(--color-neutral-550)]">buying power</span></p>
        </div>
        <div class="rounded-3xl bg-[var(--color-brand-deep-blue)] text-white p-6 flex flex-col">
          <p class="font-mono text-[10px] uppercase tracking-[0.22em] text-white/60">{t(c.chf.label)}</p>
          <p class="mt-3 text-[40px] font-black tracking-tight leading-none">{t(c.chf.value)}</p>
          <p class="mt-3 ty-body-3 text-white/80">{t(c.chf.note)}</p>
          <p class="mt-2 font-bold text-[#7ee2a8]">+{pct(chfUsd / amount - 1)} <span class="font-mono text-[10px] uppercase tracking-[0.18em] text-white/60">in dollars</span></p>
        </div>
      </div>
    </div>
    <p class="mt-4 ty-2xs text-[var(--color-neutral-550)]">{c.source}</p>
  </div>
</section>
