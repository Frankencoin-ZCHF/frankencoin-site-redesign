---
/**
 * Fifty years of USD/CHF as one static statement: the rate then and now, a line chart, and what
 * $10,000 kept in dollars vs changed into francs in 1971 is worth today. Server-rendered from
 * src/data/dollar-history.json and the live rate.
 */
import history from "../../data/dollar-history.json";
import { getLanguageFromURL, loadContent } from "../../utils/i18n";
import { getUsdChfHistory } from "../../utils/liveStats";

const lang = getLanguageFromURL(Astro.url.pathname);
const c = (await loadContent<any>("save-in-chf", lang)).fifty;
const fx = await getUsdChfHistory();
const rows = history.rows;
const first = rows[0], last = rows[rows.length - 1];
const now = fx.points.length ? fx.points[fx.points.length - 1][1] : last.usdchf;
const amount = 10000;
const loss = 1 - now / first.usdchf;
const real = amount * first.usCpi / last.usCpi;
const chf = amount * first.usdchf;
const chfUsd = chf / now;
const chfReal = chfUsd * first.usCpi / last.usCpi;
const mult = (chfUsd / amount).toFixed(1).replace(/\.0$/, "");
const locale = lang === "de" ? "de-CH" : "en-US";
const usd = (v: number) => "$" + new Intl.NumberFormat(locale, { maximumFractionDigits: 0 }).format(Math.round(v));
const chfF = (v: number) => new Intl.NumberFormat("de-CH", { maximumFractionDigits: 0 }).format(Math.round(v)) + " CHF";
const pct = (v: number) => `${Math.round(v * 100)}%`;
const t = (s: string) => s.replace("{then}", first.usdchf.toFixed(2)).replace("{now}", now.toFixed(2)).replace("{loss}", pct(loss)).replaceAll("{amount}", usd(amount)).replace("{real}", usd(real)).replace("{chfUsd}", usd(chfUsd)).replace("{chf}", chfF(chf)).replace("{chfReal}", usd(chfReal)).replace("{mult}", mult);
const series = [...rows.map((r) => r.usdchf), now];
const max = Math.max(...series);
const pts = series.map((v, i) => [(i / (series.length - 1)) * 100, 38 - (v / max) * 34] as const);
const line = pts.map(([x, y], i) => `${i ? "L" : "M"}${x.toFixed(2)} ${y.toFixed(2)}`).join(" ");
const [l1, l2] = t(c.title).split("|");
---

<section id="fifty" class="scroll-mt-24 bg-[var(--color-white)] py-20 md:py-24">
  <div class="mx-auto max-w-7xl px-[var(--spacing-l)]">
    <h2 class="text-[34px] sm:text-[46px] lg:text-[56px] leading-[1.04] font-black tracking-[-0.03em] text-[var(--color-brand-deep-blue)] m-0">
      <span class="md:whitespace-nowrap">{l1}</span><br />{l2}
    </h2>
    <p class="mt-4 text-pretty ty-body-1 text-[var(--color-neutral-650)] max-w-[40rem]">{t(c.subtitle)}</p>

    <div class="mt-10 grid lg:grid-cols-[1.4fr_1fr] gap-6 items-stretch">
      <figure class="m-0 rounded-2xl border border-[var(--color-gray-20)] bg-[var(--color-gray-10)] p-6 md:p-8 flex flex-col">
        <figcaption class="text-[12px] font-medium text-[var(--color-neutral-550)]">{c.chartLabel}</figcaption>
        <div class="flex items-baseline gap-3 mt-2">
          <span class="text-[40px] font-black tracking-tight text-[var(--color-brand-deep-blue)] leading-none">{first.usdchf.toFixed(2)}</span>
          <span class="text-[var(--color-neutral-550)]">→</span>
          <span class="text-[40px] font-black tracking-tight text-[#1a9cc8] leading-none">{now.toFixed(2)}</span>
          <span class="ml-2 rounded-full bg-[#ffe4e4] text-[#b42318] text-[11px] font-bold px-2.5 py-1">−{pct(loss)}</span>
        </div>
        <svg viewBox="0 0 100 40" preserveAspectRatio="none" class="w-full h-40 md:h-56 mt-4 flex-1" role="img" aria-label={c.chartLabel}>
          <path d={`${line} L100 40 L0 40 Z`} fill="rgba(26,156,200,0.12)" />
          <path d={line} fill="none" stroke="#1a9cc8" stroke-width="1.6" vector-effect="non-scaling-stroke" />
        </svg>
        <div class="flex justify-between text-[11px] text-[var(--color-neutral-550)] mt-1"><span>{first.year}</span><span>{new Date().getFullYear()}</span></div>
      </figure>
      <!-- One comparison, not two facts: same money, two outcomes, bars to scale, one line on why. -->
      <div class="rounded-2xl border border-[var(--color-gray-20)] bg-white p-6 md:p-6 flex flex-col gap-4">
        <p class="text-balance text-[20px] sm:text-[22px] font-black tracking-[-0.02em] text-[var(--color-brand-deep-blue)] leading-tight m-0">{t(c.tiles.head)}</p>
        <div class="flex flex-col gap-2">
          <div class="flex items-baseline justify-between gap-3">
            <span class="font-bold text-[var(--color-brand-deep-blue)]">{c.tiles.cash.label}</span>
            <span class="text-[28px] font-black tracking-tight text-[var(--color-brand-deep-blue)] leading-none tabular-nums">{usd(amount)} <span class="ty-xs font-normal text-[var(--color-neutral-550)]">{c.tiles.today}</span></span>
          </div>
          <div class="h-3 rounded-full bg-[var(--color-gray-10)] overflow-hidden"><div class="h-full rounded-full bg-[#b42318]/70" style={`width:${(amount / chfUsd) * 100}%`}></div></div>
          <p class="ty-xs text-[var(--color-neutral-650)] m-0">{t(c.tiles.cash.note)} · <b class="text-[#b42318]">−{pct(1 - real / amount)} {c.tiles.cash.tag}</b></p>
        </div>
        <div class="flex flex-col gap-2 rounded-2xl bg-[var(--color-brand-deep-blue)] text-white p-4 -mx-1">
          <div class="flex items-baseline justify-between gap-3">
            <span class="font-bold">{c.tiles.chf.label}</span>
            <span class="text-[28px] font-black tracking-tight leading-none tabular-nums">{usd(chfUsd)} <span class="ty-xs font-normal text-white/60">{c.tiles.today}</span></span>
          </div>
          <div class="h-3 rounded-full bg-white/15 overflow-hidden"><div class="h-full rounded-full bg-[#7ee2a8]" style="width:100%"></div></div>
          <p class="ty-xs text-white/80 m-0">{t(c.tiles.chf.note)} · <b class="text-[#7ee2a8]">−{pct(1 - chfReal / amount)} {c.tiles.chf.tag}</b></p>
          <span class="self-start mt-1 rounded-full bg-[#7ee2a8] text-[var(--color-brand-deep-blue)] text-[11px] font-bold px-2.5 py-1">{t(c.tiles.chf.badge)}</span>
        </div>
        <p class="ty-body-3 text-[var(--color-neutral-650)] m-0 border-t border-[var(--color-gray-20)] pt-4">{t(c.tiles.why)}</p>
      </div>
    </div>
    <p class="mt-4 ty-2xs text-[var(--color-neutral-550)]">{c.source}</p>
  </div>
</section>
