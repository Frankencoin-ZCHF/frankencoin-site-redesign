---
/**
 * Numbered steps with one action each ("Do it in 3 steps").
 * Props: steps: { title, body, cta?: { label, href, external? } }[]
 */
import { getLanguageFromURL, getLocalizedPath } from "../../utils/i18n";

interface Step { title: string; body: string; cta?: { label: string; href: string; external?: boolean } }
const { steps } = Astro.props as { steps: Step[] };
const lang = getLanguageFromURL(Astro.url.pathname);
const href = (h: string) => (h.startsWith("/") ? getLocalizedPath(h, lang) : h);
---

<ol class="grid md:grid-cols-3 gap-4 list-none m-0 p-0">
  {steps.map((s, i) => (
    <li class="flex flex-col gap-3 rounded-3xl bg-[var(--color-white)] border border-[var(--color-gray-20)] p-6 md:p-7">
      <span class="font-mono text-[40px] font-bold leading-none text-[#5bb8dc]/70">{String(i + 1).padStart(2, "0")}</span>
      <h3 class="ty-title-3 font-black text-[var(--color-brand-deep-blue)] m-0">{s.title}</h3>
      <p class="ty-body-3 text-[var(--color-neutral-650)] flex-1">{s.body}</p>
      {s.cta && (
        <a
          href={href(s.cta.href)}
          target={s.cta.external ? "_blank" : undefined}
          rel={s.cta.external ? "noopener noreferrer" : undefined}
          class="inline-flex items-center justify-center rounded-full bg-[var(--color-brand-deep-blue)] px-5 py-3 ty-body-3 font-bold text-white hover:bg-[var(--color-brand-swiss)] transition-colors"
        >
          {s.cta.label}
        </a>
      )}
    </li>
  ))}
</ol>
