---
/**
 * Cookie banner for Google Consent Mode v2. The consent *default* (everything denied) is set inline in
 * Base.astro before gtag.js loads; this component only shows the choice and updates it.
 * The choice lives in localStorage "fc-consent" = "granted" | "denied" (12 months). window.fcConsent.open()
 * reopens the banner (footer "Cookie settings", privacy page). Copy: content/{en,de}/consent.json.
 */
import { getLanguageFromURL, getLocalizedPath, loadContent } from "../../utils/i18n";
const lang = getLanguageFromURL(Astro.url.pathname);
const en = await loadContent<any>("consent", "en");
const local = await loadContent<any>("consent", lang);
const c = { ...en, ...local };
const moreHref = getLocalizedPath(c.moreHref, lang);
---

<div id="fc-consent" hidden role="dialog" aria-modal="false" aria-labelledby="fc-consent-title" class="fixed inset-x-0 bottom-0 z-[60] p-3 sm:p-5 pointer-events-none">
  <div class="pointer-events-auto mx-auto max-w-3xl rounded-2xl border border-[var(--color-gray-20)] bg-white p-5 sm:p-6 shadow-[0_12px_40px_rgba(16,36,70,0.18)] sm:flex sm:items-center sm:gap-6">
    <div class="min-w-0 flex-1">
      <p id="fc-consent-title" class="ty-body-2 font-black text-[var(--color-brand-deep-blue)] m-0">{c.title}</p>
      <p class="mt-1.5 ty-body-3 text-pretty text-[var(--color-neutral-650)] m-0">
        {c.text}
        <a href={moreHref} class="font-semibold text-[var(--color-brand-deep-blue)] underline decoration-[var(--color-brand-swiss)] underline-offset-4 hover:text-[var(--color-brand-swiss)]">{c.more}</a>
      </p>
    </div>
    <div class="mt-4 sm:mt-0 flex shrink-0 flex-wrap gap-2 sm:flex-col">
      <button type="button" data-consent="granted" class="inline-flex h-[44px] items-center justify-center rounded-[10px] bg-[var(--color-brand-deep-blue)] px-5 ty-body-3 font-bold text-white hover:bg-[var(--color-brand-swiss)] transition-colors">{c.accept}</button>
      <button type="button" data-consent="denied" class="inline-flex h-[44px] items-center justify-center rounded-[10px] border-2 border-[var(--color-gray-30)] px-5 ty-body-3 font-bold text-[var(--color-brand-deep-blue)] hover:border-[var(--color-brand-deep-blue)] transition-colors">{c.decline}</button>
    </div>
  </div>
</div>

<script is:inline>
  (function () {
    var KEY = "fc-consent";
    var MAX_AGE = 365 * 24 * 60 * 60 * 1000;
    var box = document.getElementById("fc-consent");
    if (!box) return;
    function read() {
      try {
        var raw = localStorage.getItem(KEY);
        if (!raw) return null;
        var v = JSON.parse(raw);
        if (!v || !v.choice || Date.now() - (v.at || 0) > MAX_AGE) return null;
        return v.choice;
      } catch (e) { return null; }
    }
    function apply(choice) {
      if (typeof gtag === "function") {
        gtag("consent", "update", { analytics_storage: choice === "granted" ? "granted" : "denied" });
      }
    }
    function choose(choice) {
      try { localStorage.setItem(KEY, JSON.stringify({ choice: choice, at: Date.now() })); } catch (e) {}
      apply(choice);
      box.hidden = true;
      if (window.fcTrack) window.fcTrack("consent_" + choice, { page_path: location.pathname });
    }
    box.querySelectorAll("[data-consent]").forEach(function (b) {
      b.addEventListener("click", function () { choose(b.getAttribute("data-consent")); });
    });
    window.fcConsent = { open: function () { box.hidden = false; box.querySelector("[data-consent=granted]").focus(); }, get: read };
    if (!read()) box.hidden = false;
  })();
</script>
