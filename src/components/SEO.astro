---
import { getLanguageFromURL, loadSharedContent, stripLangFromPath } from "../utils/i18n";

const currentLang = getLanguageFromURL(Astro.url.pathname);
const site = await loadSharedContent("site", currentLang);

interface Props {
  title?: string;
  description?: string;
  image?: string;
  canonical?: string;
  type?: "website" | "article";
  noindex?: boolean;
  nofollow?: boolean;
}

const {
  title = site.site.title,
  description = site.site.description,
  image = site.site.image,
  canonical,
  type = "website",
  noindex = false,
  nofollow = false,
} = Astro.props;

// Construct full image URL if relative
const fullImageUrl = image.startsWith("http")
  ? image
  : new URL(image, site.site.url).href;

// Construct robots content
const robotsContent = noindex || nofollow
  ? `${noindex ? "noindex" : "index"}, ${nofollow ? "nofollow" : "follow"}`
  : "index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1";

// Hreflang tags
const pathname = Astro.url.pathname;
const basePath = stripLangFromPath(pathname) || '/';
// One address per page: frankencoin.com, no trailing slash (server.mjs redirects the other forms), no query string.
const siteUrl = 'https://frankencoin.com';
const noSlash = (p: string) => (p.length > 1 ? p.replace(/\/+$/, '') : p);
const canonicalUrl = canonical ?? `${siteUrl}${noSlash(pathname)}`;
const enUrl = `${siteUrl}${noSlash(basePath)}`;
const deUrl = `${siteUrl}/de${basePath === '/' ? '' : noSlash(basePath)}`;
---

<!-- Primary Meta Tags -->
<title>{title}</title>
<meta name="title" content={title} />
<meta name="description" content={description} />
<meta name="keywords" content={site.site.keywords} />
<meta name="author" content={site.site.author} />
<meta name="robots" content={robotsContent} />
<link rel="canonical" href={canonicalUrl} />

<!-- Hreflang Tags -->
<link rel="alternate" hreflang="en" href={enUrl} />
<link rel="alternate" hreflang="de" href={deUrl} />
<link rel="alternate" hreflang="x-default" href={enUrl} />

<!-- Open Graph / Facebook -->
<meta property="og:type" content={type} />
<meta property="og:url" content={canonicalUrl} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={fullImageUrl} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={title} />
<meta property="og:site_name" content={site.site.name} />
<meta property="og:locale" content={site.site.locale} />

<!-- Twitter -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:url" content={canonicalUrl} />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={fullImageUrl} />
<meta name="twitter:image:alt" content={title} />
<meta name="twitter:site" content={site.site.twitterHandle} />
<meta name="twitter:creator" content={site.site.twitterHandle} />
