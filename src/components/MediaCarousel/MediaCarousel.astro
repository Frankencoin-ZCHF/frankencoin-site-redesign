---
import { getLanguageFromURL, loadContent, loadGlobalSharedContent } from "../../utils/i18n";
import { fetchOgData } from "../../utils/fetchOgData";
import { fetchYouTubeData } from "../../utils/fetchYouTubeData";

const currentLang = getLanguageFromURL(Astro.url.pathname);
const media = await loadGlobalSharedContent("media");
const index = await loadContent("index", currentLang);

interface Props {
  articles: string[];
  videos: string[];
}

const { articles, videos } = Astro.props;

// Fetch and process articles
const articlesWithMetadata = await Promise.all(
  articles.map(async (url) => {
    const ogData = await fetchOgData(url);

    const defaultData = ogData || {
      title: "Article",
      description: "",
      image: "",
      siteName: new URL(url).hostname,
      url,
      publishedDate: "",
    };

    // Check if manual override exists
    if (media.articleMetadata && media.articleMetadata[url]) {
      const manual = media.articleMetadata[url];
      return {
        ...defaultData,
        ...Object.fromEntries(
          Object.entries(manual).filter(([_, value]) => value !== "" && value !== null && value !== undefined)
        ),
        type: "article" as const,
      };
    }

    return { ...defaultData, type: "article" as const };
  })
);

// Fetch and process videos
const videosWithMetadata = await Promise.all(
  videos.map(async (url) => {
    const videoData = await fetchYouTubeData(url);

    const defaultData = videoData || {
      title: "Video",
      description: "",
      thumbnail: "",
      author: "",
      url,
      publishedDate: "",
      videoId: "",
    };

    // Check if manual override exists
    if (media.videoMetadata && media.videoMetadata[url]) {
      const manual = media.videoMetadata[url];
      return {
        ...defaultData,
        ...Object.fromEntries(
          Object.entries(manual).filter(([_, value]) => value !== "" && value !== null && value !== undefined)
        ),
        type: "video" as const,
      };
    }

    return { ...defaultData, type: "video" as const };
  })
);

// Normalize video data to match article structure for unified rendering
const normalizedVideos = videosWithMetadata.map((v) => ({
  title: v.title,
  description: v.description,
  image: v.thumbnail,
  siteName: v.author,
  url: v.url,
  publishedDate: v.publishedDate,
  type: "video" as const,
}));

// Merge and sort all items by date
const sorted = [...articlesWithMetadata, ...normalizedVideos].sort((a, b) => {
  if (!a.publishedDate && !b.publishedDate) return 0;
  if (!a.publishedDate) return 1;
  if (!b.publishedDate) return -1;
  const dateA = new Date(a.publishedDate);
  const dateB = new Date(b.publishedDate);
  return dateB.getTime() - dateA.getTime();
});
const items = sorted.slice(0, 12);
const t = currentLang === "de" ? { video: "Video", article: "Artikel", prev: "Zurück", next: "Weiter", all: "Alle Beiträge" } : { video: "Video", article: "Article", prev: "Previous", next: "Next", all: "All coverage" };
const newsHref = currentLang === "de" ? "/de/news" : "/news";
---

{/* Server-rendered track: native horizontal scroll with snap points, so the section has its full height on first paint
    (no client-side rendering, no layout shift) and works without JavaScript. The buttons scroll by one card. */}
<div x-data="{ scroll(dir) { const el = $refs.track; const card = el.querySelector('article'); el.scrollBy({ left: dir * ((card?.offsetWidth ?? 320) + 24), behavior: 'smooth' }); } }" class="relative">
  <div x-ref="track" class="flex gap-6 overflow-x-auto snap-x snap-mandatory scroll-smooth pb-4 -mx-[var(--spacing-l)] px-[var(--spacing-l)] scroll-pl-[var(--spacing-l)] [scrollbar-width:none] [&::-webkit-scrollbar]:hidden">
    {items.map((item) => (
      <article class="snap-start shrink-0 w-[82%] sm:w-[60%] md:w-[calc((100%-3rem)/3)] min-w-0">
        <a href={item.url} target="_blank" rel="noopener noreferrer" class="group flex h-full flex-col overflow-hidden rounded-3xl border border-[var(--color-gray-20)] bg-white hover:shadow-xl hover:-translate-y-0.5 transition-all">
          <div class="relative aspect-video overflow-hidden bg-gradient-to-br from-[var(--color-brand-deep-blue)] to-[#1a9cc8]">
            {item.image && <img src={item.image} alt="" loading="lazy" decoding="async" class="absolute inset-0 h-full w-full object-cover" onerror="this.remove()" />}
            {item.type === "video" && (
              <span class="absolute inset-0 flex items-center justify-center" aria-hidden="true">
                <span class="flex size-12 items-center justify-center rounded-full bg-white/90 text-[var(--color-brand-deep-blue)] shadow-lg transition-transform group-hover:scale-110"><svg class="ml-0.5 size-5" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg></span>
              </span>
            )}
            <span class:list={["absolute left-3 top-3 rounded-full px-2.5 py-1 text-[11px] font-bold text-white", item.type === "video" ? "bg-[#e02523]" : "bg-[var(--color-brand-deep-blue)]"]}>{item.type === "video" ? t.video : t.article}</span>
          </div>
          <div class="flex flex-1 flex-col p-6">
            <p class="ty-xs text-[var(--color-neutral-550)]">{item.siteName}{item.publishedDate && <span> · {item.publishedDate}</span>}</p>
            <h3 class="mt-2 ty-title-3 font-black text-[var(--color-brand-deep-blue)] line-clamp-2 m-0">{item.title}</h3>
            <p class="mt-2 ty-body-3 text-[var(--color-neutral-650)] line-clamp-3">{item.description}</p>
          </div>
        </a>
      </article>
    ))}
  </div>

  <div class="mt-6 flex flex-wrap items-center justify-between gap-4">
    <a href={newsHref} class="inline-flex font-bold ty-body-2 text-[var(--color-brand-swiss)] hover:text-[var(--color-blue-39)]">{t.all} →</a>
    <div class="flex gap-2">
      <button type="button" @click="scroll(-1)" aria-label={t.prev} class="flex size-11 items-center justify-center rounded-full border border-[var(--color-gray-30)] text-[var(--color-brand-deep-blue)] hover:bg-[var(--color-brand-deep-blue)] hover:text-white transition-colors">
        <svg class="size-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7"/></svg>
      </button>
      <button type="button" @click="scroll(1)" aria-label={t.next} class="flex size-11 items-center justify-center rounded-full bg-[var(--color-brand-deep-blue)] text-white hover:bg-[var(--color-brand-swiss)] transition-colors">
        <svg class="size-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg>
      </button>
    </div>
  </div>
</div>

<div class="mt-10">
  <p class="ty-body-3 text-[var(--color-neutral-650)]">
    {index.in_the_media.contact_text} <a href="mailto:media@frankencoin.com" class="font-bold text-[var(--color-brand-deep-blue)] hover:underline">media@frankencoin.com</a>
  </p>
</div>
