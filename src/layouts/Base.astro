---
import CookieBanner from "../components/Layout/CookieBanner.astro";
import Footer from "../components/Layout/Footer.astro";
import Header from "../components/Layout/Header.astro";
import SEO from "../components/SEO.astro";
import { getLanguageFromURL, loadSharedContent } from "../utils/i18n";
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: "website" | "article";
  noindex?: boolean;
  nofollow?: boolean;
  /** Replaces the header menu for this page (e.g. anchors to the page's own sections). */
  navLinks?: { label: string; href: string }[];
  /** Small print shown under the footer copyright (e.g. a page disclaimer). */
  footerNote?: string;
}

const { title, description, image, type, noindex, nofollow, navLinks, footerNote } = Astro.props;
const currentLang = getLanguageFromURL(Astro.url.pathname);
const site = await loadSharedContent("site", currentLang);
---

<!doctype html>
<html lang={currentLang}>
  <head>
    <!-- Basic Meta Tags -->
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#0A2540" />

    <!-- SEO Component -->
    <SEO title={title} description={description} image={image} type={type} noindex={noindex} nofollow={nofollow} />

    <!-- Favicons -->
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon.png" />
    <link rel="apple-touch-icon" sizes="256x256" href="/images/webclip.png" />
    <link rel="manifest" href="/manifest.json" />

    <!-- Structured Data (JSON-LD) -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Organization",
      "name": site.site.name,
      "url": site.site.url,
      "logo": new URL(site.site.image, site.site.url).href,
      "description": site.site.description,
      "sameAs": [
        "https://x.com/frankencoinzchf",
        "https://github.com/Frankencoin-ZCHF",
        "https://t.me/frankencoinzchf"
      ],
      "contactPoint": {
        "@type": "ContactPoint",
        "contactType": site.contact.type,
        "email": site.contact.email
      }
    })} />

    <!-- Alpine.js -->
    <script src="https://unpkg.com/alpinejs@3.x.x/dist/cdn.min.js" defer></script>

    <!-- Handle instant scroll for language switch with anchors -->
    <script is:inline>
      (function() {
        const langSwitchAnchor = sessionStorage.getItem('lang-switch-anchor');
        if (langSwitchAnchor && window.location.hash === langSwitchAnchor) {
          sessionStorage.removeItem('lang-switch-anchor');
          // Validate that the anchor is safe (must start with # and only contain safe characters)
          if (!/^#[a-zA-Z0-9_-]+$/.test(langSwitchAnchor)) {
            return; // Invalid anchor format, don't proceed
          }
          // Disable smooth scroll temporarily
          document.documentElement.style.scrollBehavior = 'auto';
          // After page load, scroll instantly to anchor
          window.addEventListener('DOMContentLoaded', function() {
            // Extract ID from hash (remove #) and use getElementById for safe lookup
            const elementId = langSwitchAnchor.substring(1);
            const element = document.getElementById(elementId);
            if (element) {
              element.scrollIntoView({ behavior: 'instant', block: 'start' });
            }
            // Restore smooth scroll after a brief delay
            setTimeout(function() {
              document.documentElement.style.scrollBehavior = '';
            }, 100);
          });
        }
      })();
    </script>

    <!-- Google Analytics with Consent Mode v2: everything denied until the visitor accepts in the cookie banner.
         Must run before gtag.js loads, so it is inline. The stored choice (localStorage "fc-consent") is re-applied here. -->
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag() { dataLayer.push(arguments); }
      gtag("consent", "default", { ad_storage: "denied", ad_user_data: "denied", ad_personalization: "denied", analytics_storage: "denied", wait_for_update: 500 });
      try {
        var fcc = JSON.parse(localStorage.getItem("fc-consent") || "null");
        if (fcc && fcc.choice === "granted" && Date.now() - (fcc.at || 0) < 365 * 24 * 60 * 60 * 1000) {
          gtag("consent", "update", { analytics_storage: "granted" });
        }
      } catch (e) {}
    </script>
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-RNM9S018ES"></script>
    <script>
      function gtag() {
        dataLayer.push(arguments);
      }
      gtag("js", new Date());
      gtag("set", "developer_id.dZGVlNj", true);
      gtag("config", "G-RNM9S018ES");

      // Site events. fcTrack(name, params) is for page scripts (e.g. the contact form); the click listener
      // reports every button-styled link ("cta_click"), app links ("app_open"), email links ("email_click")
      // and other outbound links ("outbound_click") with their text and the section they sit in.
      window.fcTrack = function (name, params) {
        try { gtag("event", name, params || {}); } catch (e) {}
      };
      document.addEventListener(
        "click",
        function (e) {
          var el = e.target && e.target.closest ? e.target.closest("a[href], button") : null;
          if (!el) return;
          var href = el.getAttribute("href") || "";
          var text = (el.innerText || el.getAttribute("aria-label") || "").replace(/\s+/g, " ").trim().slice(0, 80);
          var section = el.closest("section[id], [data-track], footer, header");
          var isButton = el.tagName === "BUTTON" || el.classList.contains("pxb") || /(^|\s)(btn|button)(\s|$|-)/.test(el.className || "");
          var params = {
            link_text: text,
            link_url: href,
            link_location: section ? section.id || section.getAttribute("data-track") || section.tagName.toLowerCase() : "",
            page_path: location.pathname,
          };
          if (isButton) window.fcTrack("cta_click", params);
          var url;
          try { url = new URL(href, location.href); } catch (err) { return; }
          if (url.protocol === "mailto:") window.fcTrack("email_click", params);
          else if (url.hostname === "app.frankencoin.com") window.fcTrack("app_open", params);
          else if (/^https?:$/.test(url.protocol) && url.hostname !== location.hostname) window.fcTrack("outbound_click", params);
        },
        true,
      );
    </script>
    <slot name="head" />
  </head>
  <body
    class="min-h-dvh flex flex-col w-full bg-[var(--color-white)] text-[var(--color-neutral-800)]"
  >
    <Header links={navLinks} />

    <main class="w-full flex-1 flex flex-col">
      <slot />
    </main>

    <Footer note={footerNote} />
    <CookieBanner />
  </body>
</html>
